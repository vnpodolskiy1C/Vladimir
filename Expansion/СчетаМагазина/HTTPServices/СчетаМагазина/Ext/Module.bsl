Функция НайтиТипы(Запрос)
	Попытка
		СтрокаПоиска = Запрос.ПараметрыЗапроса.Получить("q");
		Если СтрокаПоиска = Неопределено Или ПустаяСтрока(СокрЛП(СтрокаПоиска)) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметр q пуст");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.НайтиТипы(СтрокаПоиска));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОписатьТип(Запрос)
	Попытка
		Разрешение = СчетаМагазинаМетаданные.РазрешитьТип(Запрос.ПараметрыЗапроса.Получить("name"));
		Если Не Разрешение.ok Тогда
			Возврат ОтказJSON(Разрешение.status, Разрешение.code, Разрешение.message);
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.Схема(Разрешение.meta));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция НайтиОбъекты(Запрос)
	Попытка
		ТипИмя = Запрос.ПараметрыЗапроса.Получить("type");
		СтрокаПоиска = Запрос.ПараметрыЗапроса.Получить("q");
		Если ТипИмя = Неопределено Или ПустаяСтрока(СокрЛП(ТипИмя))
			Или СтрокаПоиска = Неопределено Или ПустаяСтрока(СокрЛП(СтрокаПоиска)) Тогда
			Возврат ОтказJSON(400, "invalid_request", "Параметры type и q обязательны");
		КонецЕсли;
		Разрешение = СчетаМагазинаМетаданные.РазрешитьТип(ТипИмя);
		Если Не Разрешение.ok Тогда
			Возврат ОтказJSON(Разрешение.status, Разрешение.code, Разрешение.message);
		КонецЕсли;
		Если Не ПравоДоступа("Чтение", Разрешение.meta) Тогда
			Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
		КонецЕсли;
		Если Метаданные.Справочники.Содержит(Разрешение.meta) И Разрешение.meta.ДлинаНаименования = 0 Тогда
			Возврат ОтказJSON(400, "invalid_request", "У справочника нет наименования");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаДанные.НайтиОбъекты(Разрешение.meta, СтрокаПоиска));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПрочитатьОбъект(Запрос)
	Попытка
		Разрешение = СчетаМагазинаМетаданные.РазрешитьТип(Запрос.ПараметрыЗапроса.Получить("type"));
		Если Не Разрешение.ok Тогда
			Возврат ОтказJSON(Разрешение.status, Разрешение.code, Разрешение.message);
		КонецЕсли;
		Идентификатор = СчетаМагазинаДанные.УникальныйИдентификаторИзСтроки(Запрос.ПараметрыЗапроса.Получить("id"));
		Если Идентификатор = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_request", "Некорректный UUID");
		КонецЕсли;
		Чтение = СчетаМагазинаДанные.Прочитать(Разрешение.meta, Идентификатор);
		Если Не Чтение.ok Тогда
			Возврат ОтказJSON(Чтение.status, Чтение.code, Чтение.message);
		КонецЕсли;
		Возврат ОтветJSON(200, Чтение.data);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция СоздатьОбъект(Запрос)
	Тело = РазобратьТело(Запрос);
	Если Тело = Неопределено Тогда
		Возврат ОтказJSON(400, "invalid_request", "Тело не является JSON");
	КонецЕсли;
	Попытка
		Результат = СчетаМагазинаДанные.Создать(Тело);
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
	Если Не Результат.ok Тогда
		Если Результат.details <> Неопределено Тогда
			Возврат ОшибкаJSON(Результат.status, Результат.code, Результат.message, Результат.details);
		КонецЕсли;
		Возврат ОтказJSON(Результат.status, Результат.code, Результат.message, Результат.path);
	КонецЕсли;
	Возврат ОтветJSON(201, Новый Структура("id", Результат.id));
КонецФункции

Функция РазобратьТело(Запрос)
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку("UTF-8"));
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Данные;
КонецФункции

Функция НеРеализовано(Маршрут)
	Возврат ОтказJSON(501, "not_implemented", "Маршрут " + Маршрут + " ещё не реализован");
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", КраткоеПредставлениеОшибки(Информация));
КонецФункции
