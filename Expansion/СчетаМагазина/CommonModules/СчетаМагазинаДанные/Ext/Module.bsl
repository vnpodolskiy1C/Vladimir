Функция Подготовить(Тело, Мета, Схема, Ошибки) Экспорт
	Результат = Новый Структура("header,tables", Новый Соответствие, Новый Соответствие);
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, Неопределено, "Тело должно быть объектом с type, header и tables");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Тело Цикл
		Если Элемент.Ключ <> "type" И Элемент.Ключ <> "header" И Элемент.Ключ <> "tables" Тогда
			Ошибка(Ошибки, Элемент.Ключ, "Неизвестное поле");
		КонецЕсли;
	КонецЦикла;
	Если ТипЗнч(Тело.Получить("header")) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "header", "Требуется объект header");
	Иначе
		ПодготовитьПоля(Тело.Получить("header"), Схема.fields, Мета, "header", Результат.header, Ошибки);
	КонецЕсли;
	Таблицы = Тело.Получить("tables");
	Если ТипЗнч(Таблицы) <> Тип("Соответствие") Тогда
		Ошибка(Ошибки, "tables", "Требуется объект tables");
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Таблицы Цикл
		Путь = "tables." + Элемент.Ключ;
		Описание = НайтиОписание(Схема.tables, Элемент.Ключ);
		Если Описание = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Описание.writable Тогда
			Ошибка(Ошибки, Путь, Описание.reason);
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Элемент.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Требуется массив строк");
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Индекс = 0;
		Для Каждого СтрокаДанных Из Элемент.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Индекс, "ЧГ=0") + "]";
			СтрокаТипизированная = Новый Соответствие;
			Если ТипЗнч(СтрокаДанных) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Требуется объект строки");
			Иначе
				ПодготовитьПоля(СтрокаДанных, Описание.fields, Мета.ТабличныеЧасти[Элемент.Ключ],
					ПутьСтроки, СтрокаТипизированная, Ошибки);
			КонецЕсли;
			Строки.Добавить(СтрокаТипизированная);
			Индекс = Индекс + 1;
		КонецЦикла;
		Результат.tables.Вставить(Элемент.Ключ, Строки);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ПодготовитьПоля(Вход, Поля, Мета, Префикс, Выход, Ошибки)
	Для Каждого Элемент Из Вход Цикл
		Путь = Префикс + "." + Элемент.Ключ;
		Поле = НайтиОписание(Поля, Элемент.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Тогда
			Ошибка(Ошибки, Путь, Поле.reason);
			Продолжить;
		КонецЕсли;
		МетаПоля = Реквизит(Мета, Элемент.Ключ);
		ОшибокДо = Ошибки.Количество();
		Значение = Преобразовать(Элемент.Значение, Поле, МетаПоля.Тип, Путь, Ошибки);
		Если ОшибокДо = Ошибки.Количество() Тогда
			Выход.Вставить(Элемент.Ключ, Значение);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Преобразовать(Вход, Поле, ТипыПоля, Путь, Ошибки)
	Если Вход = Неопределено Тогда
		Возврат ТипыПоля.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Типы = ТипыПоля.Типы();
	ИндексТипа = 0;
	Если Поле.types.Количество() > 1 Тогда
		Если ТипЗнч(Вход) <> Тип("Соответствие") Тогда
			Ошибка(Ошибки, Путь, "Составной тип требует объект type и value");
			Возврат Неопределено;
		КонецЕсли;
		ЕстьЗначение = Ложь;
		Для Каждого Ключ Из Вход Цикл
			Если Ключ.Ключ = "value" Тогда
				ЕстьЗначение = Истина;
			ИначеЕсли Ключ.Ключ <> "type" Тогда
				Ошибка(Ошибки, Путь, "Неизвестное поле типизированного значения");
			КонецЕсли;
		КонецЦикла;
		ИндексТипа = -1;
		Для Индекс = 0 По Поле.types.Количество() - 1 Цикл
			Если Поле.types[Индекс].name = Вход.Получить("type") Тогда
				ИндексТипа = Индекс;
			КонецЕсли;
		КонецЦикла;
		Если ИндексТипа = -1 Или Не ЕстьЗначение Тогда
			Ошибка(Ошибки, Путь, "Недопустимый type либо отсутствует value");
			Возврат Неопределено;
		КонецЕсли;
		Вход = Вход.Получить("value");
	КонецЕсли;
	Описание = Поле.types[ИндексТипа];
	Если Вход = Неопределено Тогда
		ОдинТип = Новый Массив;
		ОдинТип.Добавить(Типы[ИндексТипа]);
		ОписаниеОдногоТипа = Новый ОписаниеТипов(ОдинТип);
		Возврат ОписаниеОдногоТипа.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Корректно = Ложь;
	Результат = Неопределено;
	Если Описание.kind = "string" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Строка");
		Если Корректно Тогда
			Корректно = Описание.length = 0 Или СтрДлина(Вход) <= Описание.length;
			Если Описание.fixedLength И Описание.length > 0 Тогда
				Корректно = СтрДлина(Вход) = Описание.length;
			КонецЕсли;
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "number" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Число");
		Если Корректно Тогда
			Корректно = Окр(Вход, Описание.fractionDigits) = Вход
				И ?(Вход < 0, -Вход, Вход) < Pow(10, Описание.digits - Описание.fractionDigits)
				И (Не Описание.nonnegative Или Вход >= 0);
		КонецЕсли;
		Результат = Вход;
	ИначеЕсли Описание.kind = "boolean" Тогда
		Корректно = ТипЗнч(Вход) = Тип("Булево");
		Результат = Вход;
	ИначеЕсли Описание.kind = "date" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Попытка
				Результат = ПрочитатьДатуJSON(Вход, ФорматДатыJSON.ISO);
				Корректно = Вход = ДатаСтрокой(Результат, Описание.parts = "date");
			Исключение
				Корректно = Ложь;
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли Описание.kind = "catalog" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			Результат = Справочники[Описание.catalog].ПолучитьСсылку(Идентификатор);
			Если Путь = "header.Родитель" Или Путь = "header.Владелец" Тогда
				Корректно = Истина;
			Иначе
				Корректно = СсылкаДоступна(Описание.catalog, Результат, "catalog");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Описание.kind = "document" Тогда
		Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
		Если Идентификатор <> Неопределено Тогда
			Результат = Документы[Описание.document].ПолучитьСсылку(Идентификатор);
			Корректно = СсылкаДоступна(Описание.document, Результат, "document");
		КонецЕсли;
	ИначеЕсли Описание.kind = "enum" Тогда
		Если ТипЗнч(Вход) = Тип("Строка") Тогда
			Для Каждого ЗначениеМета Из Описание.values Цикл
				Если Вход = ЗначениеМета.name Тогда
					Результат = Перечисления[Описание.enumeration][Вход];
					Корректно = Истина;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если Не Корректно Тогда
		Ошибка(Ошибки, Путь, "Недопустимое значение, тип, ограничение или ссылка; ожидается " + Описание.name);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СсылкаДоступна(Имя, Ссылка, ВидСсылки)
	Если ВидСсылки = "document" Тогда
		Мета = Метаданные.Документы.Найти(Имя);
	Иначе
		Мета = Метаданные.Справочники.Найти(Имя);
	КонецЕсли;
	Если Мета = Неопределено Или Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Ложь;
	КонецЕсли;
	УсловиеГруппы = "";
	Если ВидСсылки = "catalog" И Мета.Иерархический
		И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		УсловиеГруппы = " И НЕ ЭтоГруппа";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ " + ?(ВидСсылки = "document", "Документ.", "Справочник.")
		+ Мета.Имя + " ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления" + УсловиеГруппы;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция НайтиОбъекты(Мета, СтрокаПоиска) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Шаблон", "%" + ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(СтрокаПоиска) + "%");
	Если Метаданные.Справочники.Содержит(Мета) Тогда
		УсловиеГруппы = "";
		Если Мета.Иерархический И Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			УсловиеГруппы = " И НЕ ЭтоГруппа";
		КонецЕсли;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 21
		|	Ссылка КАК Ссылка,
		|	Наименование КАК Наименование
		|ИЗ
		|	Справочник." + Мета.Имя + " КАК Объект
		|ГДЕ
		|	НЕ Объект.ПометкаУдаления
		|	И Объект.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""" + УсловиеГруппы + "
		|УПОРЯДОЧИТЬ ПО
		|	Наименование,
		|	Ссылка";
	Иначе
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 21
		|	Ссылка КАК Ссылка,
		|	Номер КАК Номер,
		|	Дата КАК Дата
		|ИЗ
		|	Документ." + Мета.Имя + " КАК Объект
		|ГДЕ
		|	НЕ Объект.ПометкаУдаления
		|	И Объект.Номер ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|УПОРЯДОЧИТЬ ПО
		|	Номер,
		|	Ссылка";
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = 20 Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Если Метаданные.Справочники.Содержит(Мета) Тогда
			Элементы.Добавить(Новый Структура("id,name", Строка(Выборка.Ссылка.УникальныйИдентификатор()), Выборка.Наименование));
		Иначе
			Элементы.Добавить(Новый Структура("id,number,date", Строка(Выборка.Ссылка.УникальныйИдентификатор()),
				Выборка.Номер, ДатаСтрокой(Выборка.Дата)));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Процедура Заполнить(Объект, Данные) Экспорт
	Для Каждого Поле Из Данные.header Цикл
		Объект[Поле.Ключ] = Поле.Значение;
	КонецЦикла;
	Для Каждого Таблица Из Данные.tables Цикл
		Для Каждого СтрокаДанных Из Таблица.Значение Цикл
			СтрокаОбъекта = Объект[Таблица.Ключ].Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция Прочитать(Мета, Идентификатор) Экспорт
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Новый Структура("ok,status,code,message", Ложь, 403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(Мета) Тогда
		Ссылка = Справочники[Мета.Имя].ПолучитьСсылку(Идентификатор);
		ИмяТипа = "Справочник." + Мета.Имя;
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ Справочник." + Мета.Имя + " ГДЕ Ссылка = &Ссылка";
	Иначе
		Ссылка = Документы[Мета.Имя].ПолучитьСсылку(Идентификатор);
		ИмяТипа = "Документ." + Мета.Имя;
		Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ Документ." + Мета.Имя + " ГДЕ Ссылка = &Ссылка";
	КонецЕсли;
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Новый Структура("ok,status,code,message", Ложь, 404, "not_found", "Объект не найден");
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Новый Структура("ok,status,code,message", Ложь, 404, "not_found", "Объект не найден");
	КонецЕсли;
	Схема = СчетаМагазинаМетаданные.Схема(Мета);
	Шапка = Новый Соответствие;
	Для Каждого Поле Из Схема.fields Цикл
		Шапка.Вставить(Поле.name, ЗначениеJSON(Объект[Поле.name], Поле, ТипРеквизита(Мета, Поле.name)));
	КонецЦикла;
	Таблицы = Новый Соответствие;
	Для Каждого Таблица Из Схема.tables Цикл
		Строки = Новый Массив;
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Для Каждого Поле Из Таблица.fields Цикл
				СтрокаJSON.Вставить(Поле.name, ЗначениеJSON(СтрокаОбъекта[Поле.name], Поле,
					ТипРеквизита(Мета.ТабличныеЧасти[Таблица.name], Поле.name)));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Данные = Новый Структура("type,id", ИмяТипа, Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("header", Шапка);
	Данные.Вставить("tables", Таблицы);
	Возврат Новый Структура("ok,data", Истина, Данные);
КонецФункции

Функция ТипРеквизита(Мета, Имя)
	Попытка
		Возврат Мета.Реквизиты[Имя].Тип;
	Исключение
		Возврат Мета.СтандартныеРеквизиты[Имя].Тип;
	КонецПопытки;
КонецФункции

Функция ЗначениеJSON(Значение, Поле, Типы)
	Описание = СчетаМагазинаМетаданные.ОписаниеТипа(ТипЗнч(Значение), Типы);
	Если Описание.kind = "unsupported" Тогда
		Возврат Неопределено;
	ИначеЕсли Описание.kind = "catalog" Или Описание.kind = "document" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), Строка(Значение.УникальныйИдентификатор()), Неопределено);
	ИначеЕсли Описание.kind = "enum" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ОбщегоНазначения.ИмяЗначенияПеречисления(Значение), Неопределено);
	ИначеЕсли Описание.kind = "date" Тогда
		Результат = ?(ЗначениеЗаполнено(Значение), ДатаСтрокой(Значение, Описание.parts = "date"), Неопределено);
	ИначеЕсли Описание.kind = "string" Или Описание.kind = "number" Или Описание.kind = "boolean" Тогда
		Результат = Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Если Результат = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Поле.types.Количество() > 1 Тогда
		Возврат Новый Структура("type,value", Описание.name, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДатаСтрокой(Значение, ТолькоДата = Ложь) Экспорт
	Результат = Формат(Значение, "ДФ=yyyy-MM-dd");
	Если Не ТолькоДата Тогда
		Результат = Результат + "T" + Формат(Значение, "ДФ=HH:mm:ss");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УникальныйИдентификаторИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрДлина(Значение) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Результат = Новый УникальныйИдентификатор(Значение);
		Если Значение = Строка(Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

Функция НайтиОписание(Описания, Имя) Экспорт
	Для Каждого Описание Из Описания Цикл
		Если Описание.name = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Реквизит(Мета, Имя)
	Попытка
		Возврат Мета.Реквизиты[Имя];
	Исключение
		Возврат Мета.СтандартныеРеквизиты[Имя];
	КонецПопытки;
КонецФункции

Процедура Ошибка(Ошибки, Путь, Текст) Экспорт
	Ошибки.Добавить(Новый Структура("path,message", Путь, Текст));
КонецПроцедуры

Функция Создать(Тело) Экспорт
	Если ТипЗнч(Тело) <> Тип("Соответствие") Или Не КлючЕсть(Тело, "type") Или Не КлючЕсть(Тело, "header") Или Не КлючЕсть(Тело, "tables") Тогда
		Возврат ОтказДанных(400, "invalid_request", "Тело должно содержать type, header и tables", Неопределено);
	КонецЕсли;
	Если ТипЗнч(Тело.Получить("type")) <> Тип("Строка")
		Или ТипЗнч(Тело.Получить("header")) <> Тип("Соответствие")
		Или ТипЗнч(Тело.Получить("tables")) <> Тип("Соответствие") Тогда
		Возврат ОтказДанных(400, "invalid_request", "Некорректная форма тела", Неопределено);
	КонецЕсли;
	Разрешение = СчетаМагазинаМетаданные.РазрешитьТип(Тело.Получить("type"));
	Если Не Разрешение.ok Тогда
		Возврат ОтказДанных(Разрешение.status, Разрешение.code, Разрешение.message, Неопределено);
	КонецЕсли;
	Шапка = Тело.Получить("header");
	Если КлючЕсть(Шапка, "ЭтоГруппа") Тогда
		Возврат ОтказДанных(400, "unsupported", "Группы этим сервисом не создаются",
			Новый Структура("path", "header.ЭтоГруппа"));
	КонецЕсли;
	Схема = СчетаМагазинаМетаданные.Схема(Разрешение.meta);
	Ошибки = Новый Массив;
	Данные = Подготовить(Тело, Разрешение.meta, Схема, Ошибки);
	Если Ошибки.Количество() = 0 Тогда
		ПроверитьВладельцаИРодителя(Разрешение.meta, Данные, Ошибки);
	КонецЕсли;
	Если Ошибки.Количество() > 0 Тогда
		Возврат ОтказДанных(400, "validation", "Некорректные данные", Новый Структура("details", Ошибки));
	КонецЕсли;
	Если Не ПравоДоступа("Добавление", Разрешение.meta) Тогда
		Возврат ОтказДанных(403, "forbidden", "Недостаточно прав на операцию", Неопределено);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Если Метаданные.Справочники.Содержит(Разрешение.meta) Тогда
			Объект = Справочники[Разрешение.meta.Имя].СоздатьЭлемент();
		Иначе
			Объект = Документы[Разрешение.meta.Имя].СоздатьДокумент();
		КонецЕсли;
		Заполнить(Объект, Данные);
		Если Не Объект.ПроверитьЗаполнение() Тогда
			ОтменитьТранзакцию();
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Возврат ОтказДанных(400, "validation", "Штатная проверка заполнения не пройдена",
				Новый Структура("details", ОшибкиЗаполненияДанных(Сообщения, Объект, Схема)));
		КонецЕсли;
		Если Метаданные.Документы.Содержит(Разрешение.meta) Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			Объект.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
		Возврат Новый Структура("ok,id", Истина, Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция КлючЕсть(Соответствие, Ключ)
	Для Каждого Элемент Из Соответствие Цикл
		Если Элемент.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОтказДанных(Статус, Код, Текст, Дополнительно)
	Результат = Новый Структура("ok,status,code,message,details,path", Ложь, Статус, Код, Текст, Неопределено, Неопределено);
	Если Дополнительно <> Неопределено И Дополнительно.Свойство("details") Тогда
		Результат.details = Дополнительно.details;
	КонецЕсли;
	Если Дополнительно <> Неопределено И Дополнительно.Свойство("path") Тогда
		Результат.path = Дополнительно.path;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Процедура ПроверитьВладельцаИРодителя(Мета, Данные, Ошибки)
	Если Не Метаданные.Справочники.Содержит(Мета) Тогда
		Возврат;
	КонецЕсли;
	Если Мета.Владельцы.Количество() > 0 Тогда
		Владелец = Данные.header.Получить("Владелец");
		Если Владелец = Неопределено Или Не ЗначениеЗаполнено(Владелец) Или Не ВладелецДоступен(Мета, Владелец) Тогда
			Ошибка(Ошибки, "header.Владелец", "У подчиненного справочника нужен непромеченный элемент справочника-владельца");
		КонецЕсли;
	КонецЕсли;
	Родитель = Данные.header.Получить("Родитель");
	Если Мета.Иерархический И Родитель <> Неопределено И ЗначениеЗаполнено(Родитель) И Не РодительДоступен(Мета, Родитель) Тогда
		Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Текст = "Родитель должен быть существующей непромеченной группой этого справочника";
		Иначе
			Текст = "Родитель должен быть существующим непромеченным элементом этого справочника";
		КонецЕсли;
		Ошибка(Ошибки, "header.Родитель", Текст);
	КонецЕсли;
КонецПроцедуры

Функция ВладелецДоступен(МетаПодчиненного, Ссылка)
	МетаВладельца = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МетаВладельца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Свой = Ложь;
	Для Каждого Владелец Из МетаПодчиненного.Владельцы Цикл
		Если Владелец = МетаВладельца Тогда
			Свой = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не Свой Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СсылкаДоступна(МетаВладельца.Имя, Ссылка, "catalog");
КонецФункции

Функция РодительДоступен(Мета, Ссылка)
	Если Не ПравоДоступа("Чтение", Мета) Тогда
		Возврат Ложь;
	КонецЕсли;
	Условие = " И НЕ ПометкаУдаления";
	Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Условие = Условие + " И ЭтоГруппа";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 Ссылка ИЗ Справочник." + Мета.Имя
		+ " ГДЕ Ссылка = &Ссылка" + Условие;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Возврат Не Запрос.Выполнить().Пустой();
	Исключение
		Если ИнформацияОбОшибке().ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
			Возврат Ложь;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ОшибкиЗаполненияДанных(Сообщения, Объект, Схема)
	Ошибки = Новый Массив;
	Если Сообщения <> Неопределено Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Ошибка(Ошибки, ПутьПоляДанных(Сообщение.Поле, Объект, Схема), Сообщение.Текст);
		КонецЦикла;
	КонецЕсли;
	Если Ошибки.Количество() = 0 Тогда
		Ошибка(Ошибки, Неопределено, "Штатная проверка заполнения отказала без сообщения");
	КонецЕсли;
	Возврат Ошибки;
КонецФункции

Функция ПутьПоляДанных(ИмяПоля, Объект, Схема)
	Если НайтиОписание(Схема.fields, ИмяПоля) <> Неопределено Тогда
		Возврат "header." + ИмяПоля;
	КонецЕсли;
	Для Каждого Таблица Из Схема.tables Цикл
		Для Индекс = 0 По Объект[Таблица.name].Количество() - 1 Цикл
			Для Каждого Поле Из Таблица.fields Цикл
				Путь = Таблица.name + "[" + Формат(Индекс, "ЧГ=0") + "]." + Поле.name;
				Если ИмяПоля = Путь Тогда
					Возврат "tables." + Путь;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
