Функция РазрешитьТип(ПолноеИмя) Экспорт
	// Ввод сверяется с конечными коллекциями; точное имя исключает регистровые алиасы.
	Для Каждого Коллекция Из КоллекцииТипов() Цикл
		Для Каждого Мета Из Коллекция.Значение Цикл
			Если Мета.ПолноеИмя() = ПолноеИмя Тогда
				Вид = "unsupported";
				Если Коллекция.Ключ = "Справочники" Тогда
					Вид = "catalog";
				ИначеЕсли Коллекция.Ключ = "Документы" Тогда
					Вид = "document";
				КонецЕсли;
				Возврат Новый Структура("name,kind,metadata", ПолноеИмя, Вид, Мета);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КоллекцииТипов()
	Результат = Новый Соответствие;
	// Только имена платформенных коллекций: клиент не выбирает обращение к API.
	Имена = "Справочники,Документы,Перечисления,Константы,Отчеты,Обработки,ПланыОбмена,"
		+ "ПланыВидовХарактеристик,ПланыСчетов,ПланыВидовРасчета,РегистрыСведений,"
		+ "РегистрыНакопления,РегистрыБухгалтерии,РегистрыРасчета,БизнесПроцессы,Задачи,"
		+ "ЖурналыДокументов,ОбщиеМодули,ОбщиеФормы,ОбщиеКоманды,ОбщиеМакеты,ОбщиеКартинки,"
		+ "ОбщиеРеквизиты,ОпределяемыеТипы,Роли,Подсистемы,HTTPСервисы,WebСервисы,"
		+ "ПараметрыСеанса,ПодпискиНаСобытия,РегламентныеЗадания,КритерииОтбора,Последовательности,"
		+ "ХранилищаНастроек,ФункциональныеОпции,ПараметрыФункциональныхОпций,"
		+ "Интерфейсы,Стили,Языки,ПакетыXDTO,WSСсылки,ВнешниеИсточникиДанных,СервисыИнтеграции,ГруппыКоманд,ЭлементыСтиля";
	Для Каждого ИмяКоллекции Из СтрРазделить(Имена, ",") Цикл
		Результат.Вставить(ИмяКоллекции, Метаданные[ИмяКоллекции]);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НайтиТипы(СтрокаПоиска, Лимит) Экспорт
	Совпадения = Новый ТаблицаЗначений;
	Совпадения.Колонки.Добавить("Имя");
	Совпадения.Колонки.Добавить("ТипОбъекта");
	Поиск = НРег(СокрЛП(СтрокаПоиска));
	Для Каждого Коллекция Из Новый Структура("catalog,document", Метаданные.Справочники, Метаданные.Документы) Цикл
		Для Каждого Мета Из Коллекция.Значение Цикл
			Если Не ПравоДоступа("Чтение", Мета) И Не ПравоДоступа("Добавление", Мета) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(НРег(Мета.ПолноеИмя()), Поиск) = 0 И СтрНайти(НРег(Мета.Представление()), Поиск) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Строка = Совпадения.Добавить();
			Строка.Имя = Мета.ПолноеИмя();
			Строка.ТипОбъекта = Новый Структура("name,kind,metadata", Мета.ПолноеИмя(), Коллекция.Ключ, Мета);
		КонецЦикла;
	КонецЦикла;
	Совпадения.Сортировать("Имя");
	Элементы = Новый Массив;
	Для Каждого Строка Из Совпадения Цикл
		Если Элементы.Количество() = Лимит Тогда
			Прервать;
		КонецЕсли;
		ТипОбъекта = Строка.ТипОбъекта;
		Элементы.Добавить(Новый Структура("name,title,kind,descriptionUrl,operations", ТипОбъекта.name,
			ТипОбъекта.metadata.Представление(), ТипОбъекта.kind, "/type?name=" + ПараметрURL(ТипОбъекта.name), Операции(ТипОбъекта)));
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, Совпадения.Количество() > Лимит);
КонецФункции

Функция Операции(ТипОбъекта) Экспорт
	Мета = ТипОбъекта.metadata;
	Чтение = ПравоДоступа("Чтение", Мета);
	Создание = ПравоДоступа("Добавление", Мета);
	ПоискДоступен = Чтение;
	ПричинаПоиска = ?(Чтение, Неопределено, "Нет права чтения типа");
	ПричинаСоздания = ?(Создание, Неопределено, "Нет права добавления типа");
	Если ТипОбъекта.kind = "catalog" Тогда
		НетПоляПоиска = Мета.ДлинаНаименования = 0;
		ДлинаНумерации = Мета.ДлинаКода;
		ИмяНумерации = "Код";
	Иначе
		НетПоляПоиска = Мета.ДлинаНомера = 0;
		ДлинаНумерации = Мета.ДлинаНомера;
		ИмяНумерации = "Номер";
	КонецЕсли;
	Если НетПоляПоиска Тогда
		ПоискДоступен = Ложь;
		ПричинаПоиска = "Метаданные не предусматривают поле поиска";
	КонецЕсли;
	МетаНумерации = Реквизит(Мета, ИмяНумерации);
	Если ДлинаНумерации > 0 И Не Мета.Автонумерация И МетаНумерации <> Неопределено
		И МетаНумерации.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку Тогда
		Создание = Ложь;
		ПричинаСоздания = "Не поддерживается обязательный код или номер без автоматического назначения";
	КонецЕсли;
	Возврат Новый Структура("search,read,create",
		Новый Структура("allowed,reason", ПоискДоступен, ПричинаПоиска),
		Новый Структура("allowed,reason", Чтение, ?(Чтение, Неопределено, "Нет права чтения типа")),
		Новый Структура("allowed,reason", Создание, ПричинаСоздания));
КонецФункции

Функция Схема(ТипОбъекта) Экспорт
	Мета = ТипОбъекта.metadata;
	Поля = Новый Массив;
	Для Каждого МетаПоля Из Мета.СтандартныеРеквизиты Цикл
		Если Не ПрименимыйСтандартныйРеквизит(ТипОбъекта, МетаПоля.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Доступен = МетаПоля.Имя = "Дата" И ТипОбъекта.kind = "document"
			Или ТипОбъекта.kind = "catalog" И (МетаПоля.Имя = "Наименование" Или МетаПоля.Имя = "Родитель" Или МетаПоля.Имя = "Владелец");
		Поля.Добавить(ОписаниеПоля(МетаПоля, Доступен, Истина, Контексты(ТипОбъекта, МетаПоля, Истина)));
	КонецЦикла;
	Для Каждого МетаПоля Из Мета.Реквизиты Цикл
		Поля.Добавить(ОписаниеПоля(МетаПоля, Истина, Ложь, Контексты(ТипОбъекта, МетаПоля)));
	КонецЦикла;
	Для Каждого МетаПоля Из ОбщиеРеквизитыОбъекта(Мета) Цикл
		Поля.Добавить(ОписаниеПоля(МетаПоля, Истина, Ложь, Контексты(ТипОбъекта, МетаПоля, Ложь, Истина)));
	КонецЦикла;
	Таблицы = Новый Массив;
	Для Каждого МетаТаблицы Из Мета.ТабличныеЧасти Цикл
		Применимость = Контексты(ТипОбъекта, МетаТаблицы);
		Доступна = МетаТаблицы.Имя <> "ДополнительныеРеквизиты" И (ТипОбъекта.kind = "document" Или Применимость.Найти("item") <> Неопределено);
		Причина = ?(Доступна, Неопределено, "Таблица закрыта для записи: дополнительные реквизиты БСП или только группа");
		Таблица = Новый Структура("name,title,appliesTo,required,readable,writable,reason,fields", МетаТаблицы.Имя,
			МетаТаблицы.Представление(), Применимость, МетаТаблицы.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку,
			Истина, Доступна, Причина, Новый Массив);
		Для Каждого МетаПоля Из МетаТаблицы.СтандартныеРеквизиты Цикл
			Таблица.fields.Добавить(ОписаниеПоля(МетаПоля, Ложь, Истина, Применимость));
		КонецЦикла;
		Для Каждого МетаПоля Из МетаТаблицы.Реквизиты Цикл
			Поле = ОписаниеПоля(МетаПоля, Доступна, Ложь, Применимость);
			Если Не Доступна Тогда
				Поле.reason = Причина;
			КонецЕсли;
			Таблица.fields.Добавить(Поле);
		КонецЦикла;
		ЕстьЧитаемоеПоле = Ложь;
		ЕстьЗаписываемоеПоле = Ложь;
		Для Каждого Поле Из Таблица.fields Цикл
			ЕстьЧитаемоеПоле = ЕстьЧитаемоеПоле Или Поле.readable;
			ЕстьЗаписываемоеПоле = ЕстьЗаписываемоеПоле Или Поле.writable;
		КонецЦикла;
		Таблица.readable = ЕстьЧитаемоеПоле;
		Таблица.writable = Доступна И ЕстьЗаписываемоеПоле;
		Если Не Таблица.writable И Таблица.reason = Неопределено Тогда
			Таблица.reason = "Таблица не содержит полей с поддержкой записи";
		КонецЕсли;
		Таблицы.Добавить(Таблица);
	КонецЦикла;
	Обмен = Новый Структура("createTemplate,compoundTemplate,nullRule,dateRule,unknownFields,readMode",
		Новый Структура("type,header,tables", ТипОбъекта.name, Новый Структура, Новый Структура),
		Новый Структура("type,value", "types[].name", Неопределено),
		"null означает штатное пустое значение типа; обязательность и запрет выбранного типа сохраняются",
		"Дата YYYY-MM-DD; дата и время YYYY-MM-DDTHH:mm:ss; время HH:mm:ss. Местное время базы, без Z и смещения",
		"reject", "completeOrError");
	Правила = Новый Массив;
	Правила.Добавить("Окончательное решение принимает штатная проверка заполнения и прав 1С; условные правила кода и настроек статически не выводятся");
	Правила.Добавить("Сервис не рассчитывает прикладные значения и не выполняет заполнение форм");
	Правила.Добавить("Документы создаются без проведения; создание групп и предопределенных элементов запрещено");
	Правила.Добавить("Группы разрешены только в поле родителя; владелец и родитель передаются явно");
	Правила.Добавить("Дополнительные реквизиты БСП читаются, но закрыты для записи и могут препятствовать созданию");
	Правила.Добавить("Чтение полное: неподдерживаемое фактическое значение вызывает отказ всего запроса с путем поля");
	Возврат Новый Структура("name,title,kind,operations,fields,tables,exchange,rules", ТипОбъекта.name, Мета.Представление(),
		ТипОбъекта.kind, Операции(ТипОбъекта), Поля, Таблицы, Обмен, Правила);
КонецФункции

Функция ПрименимыйСтандартныйРеквизит(ТипОбъекта, Имя)
	Мета = ТипОбъекта.metadata;
	Если ТипОбъекта.kind = "catalog" Тогда
		Если Имя = "Код" Тогда
			Возврат Мета.ДлинаКода > 0;
		ИначеЕсли Имя = "Наименование" Тогда
			Возврат Мета.ДлинаНаименования > 0;
		ИначеЕсли Имя = "Владелец" Тогда
			Возврат Мета.Владельцы.Количество() > 0;
		ИначеЕсли Имя = "Родитель" Тогда
			Возврат Мета.Иерархический;
		ИначеЕсли Имя = "ЭтоГруппа" Тогда
			Возврат ЕстьГруппы(ТипОбъекта);
		КонецЕсли;
	ИначеЕсли Имя = "Номер" Тогда
		Возврат Мета.ДлинаНомера > 0;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ЕстьГруппы(ТипОбъекта) Экспорт
	Возврат ТипОбъекта.kind = "catalog" И ТипОбъекта.metadata.Иерархический
		И ТипОбъекта.metadata.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов;
КонецФункции

Функция Контексты(ТипОбъекта, МетаПоля, Стандартный = Ложь, Общий = Ложь)
	Результат = Новый Массив;
	Если ТипОбъекта.kind = "document" Тогда
		Результат.Добавить("document");
		Возврат Результат;
	КонецЕсли;
	ДляЭлемента = Истина;
	ДляГруппы = ЕстьГруппы(ТипОбъекта);
	Если ДляГруппы Тогда
		Если Стандартный И МетаПоля.Имя = "Владелец" Тогда
			ДляЭлемента = ТипОбъекта.metadata.ИспользованиеПодчинения <> Метаданные.СвойстваОбъектов.ИспользованиеПодчинения.Группам;
			ДляГруппы = ТипОбъекта.metadata.ИспользованиеПодчинения <> Метаданные.СвойстваОбъектов.ИспользованиеПодчинения.Элементам;
		ИначеЕсли Не Стандартный И Не Общий Тогда
			ДляЭлемента = МетаПоля.Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы;
			ДляГруппы = МетаПоля.Использование <> Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляЭлемента;
		КонецЕсли;
	КонецЕсли;
	Если ДляЭлемента Тогда
		Результат.Добавить("item");
	КонецЕсли;
	Если ДляГруппы Тогда
		Результат.Добавить("folder");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ОписаниеПоля(МетаПоля, ДоступенДляЗаписи, Стандартный, Применимость)
	Варианты = Новый Массив;
	Чтение = Ложь;
	Запись = Ложь;
	ЧастичныйЗапрет = Ложь;
	Для Каждого ТипПоля Из МетаПоля.Тип.Типы() Цикл
		Вариант = ОписаниеТипа(ТипПоля, МетаПоля.Тип);
		Варианты.Добавить(Вариант);
		Чтение = Чтение Или Вариант.readable;
		Запись = Запись Или Вариант.writable;
		ЧастичныйЗапрет = ЧастичныйЗапрет Или Не Вариант.readable Или Не Вариант.writable;
	КонецЦикла;
	ДоступенДляЗаписи = ДоступенДляЗаписи И (Применимость.Найти("item") <> Неопределено Или Применимость.Найти("document") <> Неопределено);
	Причина = Неопределено;
	Если Не ДоступенДляЗаписи Тогда
		Причина = "Поле назначает 1С либо оно доступно только группе или закрытой таблице";
	ИначеЕсли ЧастичныйЗапрет Тогда
		Причина = "Не все варианты значения поддерживают чтение или запись; ограничения указаны в types";
	КонецЕсли;
	Обязательно = МетаПоля.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
	Если Стандартный И МетаПоля.Имя = "Дата" Тогда
		Обязательно = Истина;
	КонецЕсли;
	Возврат Новый Структура("name,title,standard,appliesTo,required,readable,writable,reason,types", МетаПоля.Имя,
		МетаПоля.Представление(), Стандартный, Применимость, Обязательно, Чтение, Запись И ДоступенДляЗаписи, Причина, Варианты);
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	Описание = Новый Структура("name,kind,readable,writable,reason", Строка(ТипПоля), "unsupported", Ложь, Ложь, Неопределено);
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Описание.name = "date";
		Описание.kind = "date";
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", ?(Часть = ЧастиДаты.Время, "time", "dateTime")));
	ИначеЕсли ТипПоля = Тип("УникальныйИдентификатор") Тогда
		Описание.name = "uuid";
		Описание.kind = "uuid";
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено Тогда
			// Метаданные одного объекта соответствуют также Object/Manager: это не ссылки.
			Если ЭтоСсылочныйТип(ТипПоля) Тогда
				Описание.name = XMLТип(ТипПоля).ИмяТипа;
				Описание.kind = "reference";
				Описание.Вставить("targetType", МетаТипа.ПолноеИмя());
				Описание.Вставить("searchUrl", Неопределено);
				Описание.Вставить("objectUrl", Неопределено);
				Если Справочники.ТипВсеСсылки().СодержитТип(ТипПоля) Тогда
					Описание.kind = "catalog";
				ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПоля) Тогда
					Описание.kind = "document";
				ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипПоля) Тогда
					Описание.kind = "enum";
					Описание.Вставить("values", Новый Массив);
					Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
						Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
					КонецЦикла;
				КонецЕсли;
				Если Описание.kind = "catalog" Или Описание.kind = "document" Тогда
					Описание.searchUrl = "/search?type=" + ПараметрURL(Описание.targetType) + "&q={q}&limit={limit}";
					Описание.objectUrl = "/object?type=" + ПараметрURL(Описание.targetType) + "&id={id}";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Описание.readable = Описание.kind <> "unsupported";
	Описание.writable = Описание.readable И Описание.kind <> "reference";
	Если Описание.kind = "unsupported" Тогда
		Описание.reason = "Вариант значения не поддерживается; фактическое значение отклоняет полное чтение";
	ИначеЕсли Описание.kind = "reference" Тогда
		Описание.reason = "Ссылочный вид доступен только для чтения; поиск и чтение целевого объекта не поддерживаются";
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция ЭтоСсылочныйТип(ТипПоля)
	Возврат Справочники.ТипВсеСсылки().СодержитТип(ТипПоля) Или Документы.ТипВсеСсылки().СодержитТип(ТипПоля)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипПоля) Или ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипПоля)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипПоля) Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипПоля)
		Или ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипПоля) Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипПоля)
		Или Задачи.ТипВсеСсылки().СодержитТип(ТипПоля) Или БизнесПроцессы.ТипВсеСсылкиТочекМаршрутаБизнесПроцессов().СодержитТип(ТипПоля);
КонецФункции

Функция ПараметрURL(Значение)
	Возврат КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL);
КонецФункции

Функция НайтиОписание(Описания, Имя) Экспорт
	Для Каждого Описание Из Описания Цикл
		Если Описание.name = Имя Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ОбщиеРеквизитыОбъекта(МетаОбъекта)
	Результат = Новый Массив;
	// Общий реквизит принадлежит шапке объекта, а не строкам его таблиц.
	ЧастиИмени = СтрРазделить(МетаОбъекта.ПолноеИмя(), ".");
	Если ЧастиИмени.Количество() <> 2 Тогда
		Возврат Результат;
	КонецЕсли;
	Если ЧастиИмени[0] <> "Справочник" И ЧастиИмени[0] <> "Документ" Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Если ОбщийРеквизит.РазделениеДанных <> Метаданные.СвойстваОбъектов.РазделениеДанныхОбщегоРеквизита.НеИспользовать Тогда
			Продолжить;
		КонецЕсли;
		ЭлементСостава = ОбщийРеквизит.Состав.Найти(МетаОбъекта);
		Если ЭлементСостава = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЭлементСостава.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Использовать
			Или ЭлементСостава.Использование = Метаданные.СвойстваОбъектов.ИспользованиеОбщегоРеквизита.Авто
				И ОбщийРеквизит.АвтоИспользование = Метаданные.СвойстваОбъектов.АвтоИспользованиеОбщегоРеквизита.Использовать Тогда
			Результат.Добавить(ОбщийРеквизит);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Реквизит(МетаОбъекта, Имя) Экспорт
	Для Каждого Стандартный Из МетаОбъекта.СтандартныеРеквизиты Цикл
		Если Стандартный.Имя = Имя Тогда
			Возврат Стандартный;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Прикладной Из МетаОбъекта.Реквизиты Цикл
		Если Прикладной.Имя = Имя Тогда
			Возврат Прикладной;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Общий Из ОбщиеРеквизитыОбъекта(МетаОбъекта) Цикл
		Если Общий.Имя = Имя Тогда
			Возврат Общий;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции
