Функция Документ() Экспорт
	Возврат Метаданные.Документы.Найти("_ДемоСчетНаОплатуПокупателю");
КонецФункции

Функция Схема() Экспорт
	Мета = Документ();
	Поля = Новый Массив;
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Поле = ОписаниеПоля(Реквизит, Реквизит.Имя = "Дата", Истина);
		Поле.required = Реквизит.Имя = "Дата";
		Если Не Поле.writable Тогда
			Поле.Вставить("reason", "Стандартное техническое поле назначает 1С");
		КонецЕсли;
		Поля.Добавить(Поле);
	КонецЦикла;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Поля.Добавить(ОписаниеПоля(Реквизит, Истина));
	КонецЦикла;
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		Доступна = Таблица.Имя <> "ДополнительныеРеквизиты";
		Описание = Новый Структура("name,title,writable,required,fields", Таблица.Имя,
			Таблица.Представление(), Доступна,
			Таблица.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку, Новый Массив);
		Если Не Доступна Тогда
			Описание.Вставить("reason", "Дополнительные свойства БСП не поддерживаются этой версией");
		КонецЕсли;
		Для Каждого Реквизит Из Таблица.СтандартныеРеквизиты Цикл
			Описание.fields.Добавить(ОписаниеПоля(Реквизит, Ложь, Истина));
		КонецЦикла;
		Для Каждого Реквизит Из Таблица.Реквизиты Цикл
			Описание.fields.Добавить(ОписаниеПоля(Реквизит, Доступна));
		КонецЦикла;
		Таблицы.Добавить(Описание);
	КонецЦикла;
	Правила = Новый Структура;
	Правила.Вставить("validation", "Окончательное решение принимает штатная проверка заполнения 1С; условные правила зависят от данных и настроек базы");
	Правила.Вставить("dates", "ISO 8601 без часового пояса; местное время базы");
	Правила.Вставить("null", "Штатное пустое значение; обязательность проверяет 1С");
	Правила.Вставить("amounts", "Суммы передаёт магазин; сервис их не рассчитывает");
	Возврат Новый Структура("document,fields,tables,rules", Мета.Имя, Поля, Таблицы, Правила);
КонецФункции

Функция ОписаниеПоля(Реквизит, ДоступенДляЗаписи, Стандартный = Ложь) Экспорт
	Обязательно = Ложь;
	Если Не Стандартный Тогда
		Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
	КонецЕсли;
	Поле = Новый Структура("name,title,writable,required,types", Реквизит.Имя,
		Реквизит.Представление(), ДоступенДляЗаписи, Обязательно, Новый Массив);
	Для Каждого ТипПоля Из Реквизит.Тип.Типы() Цикл
		Описание = ОписаниеТипа(ТипПоля, Реквизит.Тип);
		Поле.types.Добавить(Описание);
		Если Описание.kind = "unsupported" Тогда
			Поле.writable = Ложь;
			Поле.Вставить("reason", "Тип поля не поддерживается этой версией: " + Описание.name);
		КонецЕсли;
	КонецЦикла;
	Если Не Поле.writable И Не Поле.Свойство("reason") Тогда
		Поле.Вставить("reason", "Поле недоступно для записи через этот сервис");
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	Описание = Новый Структура("name,kind", Строка(ТипПоля), "unsupported");
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Описание.name = "date";
		Описание.kind = "date";
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", "dateTime"));
		Если Часть = ЧастиДаты.Время Тогда
			Описание.kind = "unsupported";
		КонецЕсли;
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено Тогда
			Если Метаданные.Справочники.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "CatalogRef." + МетаТипа.Имя;
				Описание.kind = "catalog";
				Описание.Вставить("catalog", МетаТипа.Имя);
				Описание.Вставить("searchUrl", "/catalogs/" + МетаТипа.Имя);
			ИначеЕсли Метаданные.Перечисления.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Описание.name = "EnumRef." + МетаТипа.Имя;
				Описание.kind = "enum";
				Описание.Вставить("enumeration", МетаТипа.Имя);
				Описание.Вставить("values", Новый Массив);
				Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
					Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция РазрешенныеСправочники() Экспорт
	Результат = Новый Соответствие;
	Мета = Документ();
	ДобавитьСправочники(Результат, Мета.Реквизиты);
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		ДобавитьСправочники(Результат, Таблица.Реквизиты);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ДобавитьСправочники(Результат, Реквизиты)
	Для Каждого Реквизит Из Реквизиты Цикл
		Для Каждого ТипПоля Из Реквизит.Тип.Типы() Цикл
			МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
			Если МетаТипа <> Неопределено И Метаданные.Справочники.Найти(МетаТипа.Имя) = МетаТипа Тогда
				Результат.Вставить(МетаТипа.Имя, МетаТипа);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция НайтиТипы(СтрокаПоиска) Экспорт
	Образец = НРег(СокрЛП(СтрокаПоиска));
	Кандидаты = Новый Массив;
	ДобавитьТипы(Кандидаты, Метаданные.Справочники, "Справочник.", "catalog", Образец);
	ДобавитьТипы(Кандидаты, Метаданные.Документы, "Документ.", "document", Образец);
	Список = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		Список.Добавить(Кандидат, Кандидат.name);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Индекс = 0;
	Для Каждого ЭлементСписка Из Список Цикл
		Если Индекс = 20 Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(ЭлементСписка.Значение);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Процедура ДобавитьТипы(Кандидаты, Коллекция, Префикс, Вид, Образец)
	Для Каждого Мета Из Коллекция Цикл
		Имя = Префикс + Мета.Имя;
		Заголовок = Мета.Представление();
		Если СтрНайти(НРег(Имя), Образец) > 0 Или СтрНайти(НРег(Заголовок), Образец) > 0 Тогда
			Кандидаты.Добавить(Новый Структура("name,title,kind", Имя, Заголовок, Вид));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
