Функция РазрешитьТип(Имя) Экспорт
	Результат = Новый Структура("ok,status,code,message,kind,meta,typeName",
		Ложь, 400, "invalid_request", "Ожидается имя вида Вид.Имя", "", Неопределено, "");
	Если ТипЗнч(Имя) <> Тип("Строка") Или ПустаяСтрока(СокрЛП(Имя)) Или Имя <> СокрЛП(Имя) Или СтрНайти(Имя, " ") > 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Части = СтрРазделить(Имя, ".", Истина);
	Если Части.Количество() <> 2 Или ПустаяСтрока(Части[0]) Или ПустаяСтрока(Части[1]) Тогда
		Возврат Результат;
	КонецЕсли;
	Вид = Части[0];
	ИмяМета = Части[1];
	Если Вид = "Справочник" Тогда
		Мета = Метаданные.Справочники.Найти(ИмяМета);
		Префикс = "Справочник.";
		ВидJSON = "catalog";
	ИначеЕсли Вид = "Документ" Тогда
		Мета = Метаданные.Документы.Найти(ИмяМета);
		Префикс = "Документ.";
		ВидJSON = "document";
	Иначе
		Результат.code = "unsupported_type";
		Результат.message = "Вид метаданных не поддерживается";
		Возврат Результат;
	КонецЕсли;
	Если Мета = Неопределено Тогда
		Результат.status = 404;
		Результат.code = "unknown_type";
		Результат.message = "Справочник или документ не найден";
		Возврат Результат;
	КонецЕсли;
	Результат.ok = Истина;
	Результат.kind = ВидJSON;
	Результат.meta = Мета;
	Результат.typeName = Префикс + Мета.Имя;
	Результат.message = "";
	Возврат Результат;
КонецФункции

Функция НайтиТипы(СтрокаПоиска) Экспорт
	Образец = НРег(СокрЛП(СтрокаПоиска));
	Кандидаты = Новый Массив;
	ДобавитьТипы(Кандидаты, Метаданные.Справочники, "Справочник.", "catalog", Образец);
	ДобавитьТипы(Кандидаты, Метаданные.Документы, "Документ.", "document", Образец);
	Список = Новый СписокЗначений;
	Для Каждого Кандидат Из Кандидаты Цикл
		Список.Добавить(Кандидат, Кандидат.name);
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Индекс = 0;
	Для Каждого ЭлементСписка Из Список Цикл
		Если Индекс = 20 Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(ЭлементСписка.Значение);
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Процедура ДобавитьТипы(Кандидаты, Коллекция, Префикс, Вид, Образец)
	Для Каждого Мета Из Коллекция Цикл
		Имя = Префикс + Мета.Имя;
		Заголовок = Мета.Представление();
		Если СтрНайти(НРег(Имя), Образец) > 0 Или СтрНайти(НРег(Заголовок), Образец) > 0 Тогда
			Кандидаты.Добавить(Новый Структура("name,title,kind", Имя, Заголовок, Вид));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция Схема(Мета) Экспорт
	ЭтоСправочник = Метаданные.Справочники.Содержит(Мета);
	Иерархия = "none";
	Подчиненный = Ложь;
	Владельцы = Новый Массив;
	Если ЭтоСправочник Тогда
		Вид = "catalog";
		ИмяТипа = "Справочник." + Мета.Имя;
		Если Мета.Иерархический Тогда
			Если Мета.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
				Иерархия = "foldersAndItems";
			Иначе
				Иерархия = "items";
			КонецЕсли;
		КонецЕсли;
		Подчиненный = Мета.Владельцы.Количество() > 0;
		Для Каждого Владелец Из Мета.Владельцы Цикл
			Если Метаданные.Справочники.Содержит(Владелец) Тогда
				Владельцы.Добавить("Справочник." + Владелец.Имя);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Вид = "document";
		ИмяТипа = "Документ." + Мета.Имя;
	КонецЕсли;
	Поля = Новый Массив;
	Для Каждого Реквизит Из Мета.СтандартныеРеквизиты Цикл
		Поля.Добавить(СтандартноеПоле(Мета, Реквизит, ЭтоСправочник));
	КонецЦикла;
	Для Каждого Реквизит Из Мета.Реквизиты Цикл
		Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
		Поля.Добавить(ОписаниеПоля(Реквизит, Истина, Обязательно));
	КонецЦикла;
	Таблицы = Новый Массив;
	Для Каждого Таблица Из Мета.ТабличныеЧасти Цикл
		Доступна = Таблица.Имя <> "ДополнительныеРеквизиты";
		ПричинаТаблицы = "";
		Если Не Доступна Тогда
			ПричинаТаблицы = "Дополнительные свойства БСП не поддерживаются этой версией";
		КонецЕсли;
		Описание = ОписаниеПоляТаблицы(Таблица, Доступна, ПричинаТаблицы);
		Для Каждого Реквизит Из Таблица.СтандартныеРеквизиты Цикл
			Описание.fields.Добавить(ОписаниеПоля(Реквизит, Ложь, Ложь, "Поле назначает 1С"));
		КонецЦикла;
		Для Каждого Реквизит Из Таблица.Реквизиты Цикл
			Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
			Описание.fields.Добавить(ОписаниеПоля(Реквизит, Доступна, Обязательно, ПричинаТаблицы));
		КонецЦикла;
		Таблицы.Добавить(Описание);
	КонецЦикла;
	Правила = Новый Структура;
	Правила.Вставить("validation", "Окончательное решение принимает штатная проверка заполнения; условные правила зависят от данных и настроек базы");
	Правила.Вставить("dates", "ISO 8601 без часового пояса, местное время базы");
	Правила.Вставить("null", "Штатное пустое значение; обязательность проверяет 1С, кроме владельца подчиненного справочника");
	Правила.Вставить("values", "Сервис не вычисляет реквизиты и записывает переданные значения");
	Возврат Новый Структура("type,kind,title,hierarchical,hierarchy,subordinate,owners,fields,tables,rules",
		ИмяТипа, Вид, Мета.Представление(), ЭтоСправочник И Мета.Иерархический, Иерархия, Подчиненный, Владельцы, Поля, Таблицы, Правила);
КонецФункции

Функция СтандартноеПоле(Мета, Реквизит, ЭтоСправочник)
	Имя = Реквизит.Имя;
	Доступен = Ложь;
	Обязательно = Ложь;
	Причина = "Поле назначает 1С";
	Если ЭтоСправочник Тогда
		Если Имя = "Наименование" И Мета.ДлинаНаименования > 0 Тогда
			Доступен = Истина;
			Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
		ИначеЕсли Имя = "Код" И Мета.ДлинаКода > 0 Тогда
			Доступен = Истина;
			Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
		ИначеЕсли Имя = "Родитель" И Мета.Иерархический Тогда
			Доступен = Истина;
			Обязательно = Реквизит.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку;
		ИначеЕсли Имя = "Владелец" И Мета.Владельцы.Количество() > 0 Тогда
			Доступен = Истина;
			Обязательно = Истина;
		ИначеЕсли Имя = "ЭтоГруппа" Тогда
			Причина = "Группы этим сервисом не создаются";
		КонецЕсли;
	ИначеЕсли Имя = "Дата" Тогда
		Доступен = Истина;
		Обязательно = Истина;
	ИначеЕсли Имя = "Проведен" Тогда
		Причина = "Документ записывается непроведенным";
	КонецЕсли;
	Возврат ОписаниеПоля(Реквизит, Доступен, Обязательно, Причина);
КонецФункции

Функция ОписаниеПоляТаблицы(Таблица, Доступна, Причина)
	Описание = Новый Структура("name,title,writable,required,fields", Таблица.Имя, Таблица.Представление(), Доступна,
		Таблица.ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку, Новый Массив);
	Если Не Доступна Тогда
		Описание.Вставить("reason", Причина);
	КонецЕсли;
	Возврат Описание;
КонецФункции

Функция ОписаниеПоля(Реквизит, ДоступенДляЗаписи, Обязательно, Причина = "") Экспорт
	Поле = Новый Структура("name,title,writable,required,types", Реквизит.Имя,
		Реквизит.Представление(), ДоступенДляЗаписи, Обязательно, Новый Массив);
	Для Каждого ТипПоля Из Реквизит.Тип.Типы() Цикл
		Описание = ОписаниеТипа(ТипПоля, Реквизит.Тип);
		Поле.types.Добавить(Описание);
		Если Описание.kind = "unsupported" Тогда
			Поле.writable = Ложь;
			Поле.Вставить("reason", "Тип поля не поддерживается этой версией: " + Описание.name);
		КонецЕсли;
	КонецЦикла;
	Если Не Поле.writable И Не Поле.Свойство("reason") Тогда
		Если ПустаяСтрока(Причина) Тогда
			Причина = "Поле назначает 1С";
		КонецЕсли;
		Поле.Вставить("reason", Причина);
	КонецЕсли;
	Возврат Поле;
КонецФункции

Функция ОписаниеТипа(ТипПоля, ОписаниеТиповПоля) Экспорт
	Описание = Новый Структура("name,kind", Строка(ТипПоля), "unsupported");
	Если ТипПоля = Тип("Строка") Тогда
		Описание.name = "string";
		Описание.kind = "string";
		Описание.Вставить("length", ОписаниеТиповПоля.КвалификаторыСтроки.Длина);
		Описание.Вставить("fixedLength", ОписаниеТиповПоля.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная);
	ИначеЕсли ТипПоля = Тип("Число") Тогда
		Описание.name = "number";
		Описание.kind = "number";
		Квалификатор = ОписаниеТиповПоля.КвалификаторыЧисла;
		Описание.Вставить("digits", Квалификатор.Разрядность);
		Описание.Вставить("fractionDigits", Квалификатор.РазрядностьДробнойЧасти);
		Описание.Вставить("nonnegative", Квалификатор.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный);
	ИначеЕсли ТипПоля = Тип("Булево") Тогда
		Описание.name = "boolean";
		Описание.kind = "boolean";
	ИначеЕсли ТипПоля = Тип("Дата") Тогда
		Часть = ОписаниеТиповПоля.КвалификаторыДаты.ЧастиДаты;
		Если Часть = ЧастиДаты.Время Тогда
			Возврат Описание;
		КонецЕсли;
		Описание.name = "date";
		Описание.kind = "date";
		Описание.Вставить("parts", ?(Часть = ЧастиДаты.Дата, "date", "dateTime"));
	Иначе
		МетаТипа = Метаданные.НайтиПоТипу(ТипПоля);
		Если МетаТипа <> Неопределено И Метаданные.Справочники.Содержит(МетаТипа) Тогда
			ЗаполнитьСсылочныйТип(Описание, "catalog", "Справочник." + МетаТипа.Имя, "catalog", МетаТипа.Имя);
		ИначеЕсли МетаТипа <> Неопределено И Метаданные.Документы.Содержит(МетаТипа) Тогда
			ЗаполнитьСсылочныйТип(Описание, "document", "Документ." + МетаТипа.Имя, "document", МетаТипа.Имя);
		ИначеЕсли МетаТипа <> Неопределено И Метаданные.Перечисления.Содержит(МетаТипа) Тогда
			Описание.name = "Перечисление." + МетаТипа.Имя;
			Описание.kind = "enum";
			Описание.Вставить("enumeration", МетаТипа.Имя);
			Описание.Вставить("values", Новый Массив);
			Для Каждого ЗначениеМета Из МетаТипа.ЗначенияПеречисления Цикл
				Описание.values.Добавить(Новый Структура("name,title", ЗначениеМета.Имя, ЗначениеМета.Представление()));
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат Описание;
КонецФункции

Процедура ЗаполнитьСсылочныйТип(Описание, Вид, ИмяТипа, КлючИмени, ИмяМета)
	Описание.name = ИмяТипа;
	Описание.kind = Вид;
	Описание.Вставить(КлючИмени, ИмяМета);
	Описание.Вставить("searchUrl", "/search?type=" + ИмяТипа);
КонецПроцедуры
