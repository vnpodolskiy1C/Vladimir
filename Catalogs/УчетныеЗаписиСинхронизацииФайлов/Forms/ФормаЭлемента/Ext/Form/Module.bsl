#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.АвторФайлов) Тогда
		ВКачествеАвтораФайлов = "Пользователь";
		Элементы.АвторФайлов.Доступность = Истина;
	Иначе
		ВКачествеАвтораФайлов = "ПланОбмена";
		Элементы.АвторФайлов.Доступность = Ложь;
	КонецЕсли;
	
	ОблачныеСервисы = Новый СписокЗначений();
	РаботаСФайламиЛокализация.ПриОпределенииОблачныхСервисов(ОблачныеСервисы);
	Для Каждого ОблачныйСервис Из ОблачныеСервисы Цикл
		Элементы.Сервис.СписокВыбора.Вставить(0, ОблачныйСервис.Значение, ОблачныйСервис.Представление);
	КонецЦикла;
	
	АвтоНаименование = ПустаяСтрока(Объект.Наименование); 
	Если Не ПустаяСтрока(Объект.Наименование) Тогда
		Элементы.ВКачествеАвтораФайлов.СписокВыбора[0].Представление =
			НСтр("ru = 'Эта учетная запись'") + " (" + Объект.Наименование + ")";
	КонецЕсли;
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов") Тогда
		МодульЗапретРедактированияРеквизитовОбъектов = ОбщегоНазначения.ОбщийМодуль("ЗапретРедактированияРеквизитовОбъектов");
		МодульЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		ПараметрыУчетнойЗаписи = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка, "Логин, Пароль");
		УстановитьПривилегированныйРежим(Ложь);
		
		Логин  = ПараметрыУчетнойЗаписи.Логин;
		Пароль = ?(ЗначениеЗаполнено(ПараметрыУчетнойЗаписи.Пароль), УникальныйИдентификатор, "");
		
	КонецЕсли;

	Если ОбщегоНазначения.ЭтоМобильныйКлиент() Тогда
		Элементы.Наименование.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ЭтоВариантИнтерфейса85() Тогда
		Элементы.ГруппаНастройки.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	Если УказанНебезопасныйСервис(ЭтотОбъект) Тогда
		НастроитьПредупреждениеОНебезопасномПротоколе();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Логин, "Логин");
	Если ПарольИзменен Тогда
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Пароль);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	АвтоНаименование = ПустаяСтрока(Объект.Наименование); 
КонецПроцедуры

&НаКлиенте
Процедура СервисОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Не АвтоНаименование Тогда
		Возврат;
	КонецЕсли;

	ВыбранныйСервис = Элементы.Сервис.СписокВыбора.НайтиПоЗначению(ВыбранноеЗначение);
	Если Не ПустаяСтрока(ВыбранноеЗначение) И ВыбранныйСервис <> Неопределено Тогда
		Объект.Наименование = ВыбранныйСервис.Представление;	
	Иначе
		Объект.Наименование = НСтр("ru = 'Облачный сервис файлов'");	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВКачествеАвтораФайловПриИзменении(Элемент)
	
	Объект.АвторФайлов = Неопределено;
	Элементы.АвторФайлов.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	
	ПарольИзменен = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СервисПриИзменении(Элемент)
	Если УказанНебезопасныйСервис(ЭтотОбъект) Тогда
		НастроитьПредупреждениеОНебезопасномПротоколе();
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьСтатусИлиВажноеСообщение(ЭтотОбъект, "ПредупреждениеОНебезопасномПротоколе");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВКачествеАвтораФайловПользовательПриИзменении(Элемент)
	Элементы.АвторФайлов.Доступность = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьНастройки(Команда)
	
	ОчиститьСообщения();
	
	Если Объект.Ссылка.Пустая() Или Модифицированность Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьНастройкиЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Для проверки настроек необходимо записать данные учетной записи. Продолжить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Продолжить", НСтр("ru = 'Продолжить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки);
		Возврат;
	КонецЕсли;
	
	ПроверитьВозможностьСинхронизацииСОблачнымСервисом();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Сервис

&НаКлиентеНаСервереБезКонтекста
Функция УказанНебезопасныйСервис(Форма)
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(Форма.Объект.Сервис);
	Результат = СтруктураURI.Схема = "http";
	Возврат Результат;
КонецФункции

&НаСервере
Процедура НастроитьПредупреждениеОНебезопасномПротоколе()
	ПараметрыСообщения = ОбщегоНазначения.ПараметрыВажногоСообщения();
	ПараметрыСообщения.Сообщение = НСтр("ru = 'Выбранный сервис работает по протоколу http - данные авторизации будут передаваться небезопасно.'");
	ПараметрыСообщения.Скрываемый = Ложь;
	ПараметрыСообщения.КраткоеПредставление = НСтр("ru = 'Предупреждение о небезопасной схеме сервиса'");
	ПараметрыСообщения.Идентификатор = "ПредупреждениеОНебезопасномПротоколе";
	ОбщегоНазначения.ДобавитьВажноеСообщение(ЭтотОбъект, ПараметрыСообщения);
	
	ОбщегоНазначения.ВывестиСтатусыИВажныеСообщенияНаФорму(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	МодульЗапретРедактированияРеквизитовОбъектовКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЗапретРедактированияРеквизитовОбъектовКлиент");
	МодульЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ПроверитьНастройкиЗавершение(РезультатДиалога, ДополнительныеПараметры) Экспорт
	
	Если РезультатДиалога <> "Продолжить" Тогда
		Возврат;
	КонецЕсли;
	
	Если Не Записать() Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьВозможностьСинхронизацииСОблачнымСервисом();
	
КонецПроцедуры

#КонецОбласти

#Область ПроверитьВозможностьСинхронизацииСОблачнымСервисом

&НаКлиенте
Процедура ПроверитьВозможностьСинхронизацииСОблачнымСервисом()
	
	РезультатПроверки = ВыполнитьПроверкуПодключения(Объект.Ссылка);
	Если РезультатПроверки.Отказ Тогда
		ОписаниеОтказа = ОписаниеОтказа(РезультатПроверки);
			
		КартинкаПредупреждения = БиблиотекаКартинок.ДиалогСтоп;
		Шаблон = НСтр("ru = 'Проверка параметров для синхронизации файлов завершилась неудачно.
				|
				|Рекомендуем:
				|%1
				|
				|Технические подробности:
				|Сервис %2 вернул код ошибки %3.
				|%4
				|
				|%5'");
				
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
				ОписаниеОтказа.Рекомендации, Объект.Сервис, ОписаниеОтказа.КодОшибки, 
				ОписаниеОтказа.Ошибки, ОписаниеОтказа.Протокол);
	Иначе

		КартинкаПредупреждения = БиблиотекаКартинок.Успешно32;
		Шаблон = НСтр("ru = 'Проверка параметров для синхронизации файлов завершилась успешно. 
			|%1'");
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, РезультатПроверки.РезультатТекст);
	КонецЕсли;

	ПараметрыВопроса = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	ПараметрыВопроса.ПредлагатьБольшеНеЗадаватьЭтотВопрос = Ложь;
	ПараметрыВопроса.Заголовок = НСтр("ru = 'Проверка настройки'");
	ПараметрыВопроса.Картинка = КартинкаПредупреждения;
	
	СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(Неопределено, ТекстПредупреждения,
		РежимДиалогаВопрос.ОК, ПараметрыВопроса);	
КонецПроцедуры

&НаКлиенте
Функция ОписаниеОтказа(РезультатПроверки)
	Рекомендации = Новый Массив;
	Ошибки = Новый Массив();
	ЭлементыПротокола = Новый Массив();
	КодОшибки = Неопределено;

	ПротоколПроверки = СтроковыеФункцииКлиентСервер.ИзвлечьТекстИзHTML(РезультатПроверки.РезультатПротокол);
	Если Не ЗначениеЗаполнено(РезультатПроверки.КодОшибки) Тогда
		ДобавитьЭлементПротокола(ЭлементыПротокола, НСтр("ru='Протокол проверки:'"), ПротоколПроверки);
		
		ДиагностикаСоединения = ДиагностикаСоединения(Объект.Сервис);
		Если ДиагностикаСоединения = Неопределено Тогда
			Ошибки.Добавить(НСтр("ru='Проверьте соединение с сетью Интернет.'"));
		Иначе
			Ошибки.Добавить(ДиагностикаСоединения.ОписаниеОшибки);
			ДобавитьЭлементПротокола(ЭлементыПротокола, НСтр("ru='Журнал диагностики:'"), ДиагностикаСоединения.ЖурналДиагностики);
		КонецЕсли;
		
		КодОшибки = КодОшибкиИзПротоколаПроверки(ПротоколПроверки);
	Иначе
		КодОшибки = РезультатПроверки.КодОшибки;
	КонецЕсли;

	Если КодОшибки = 10404 Тогда // Сервер, не поддерживает сохранение дополнительных свойств файлов
		КодОшибки = КодОшибки - 10000;
	Иначе
		РекомендацияПоКодуОшибки = РекомендацияПоКодуОшибки(КодОшибки);
		Если ЗначениеЗаполнено(РекомендацияПоКодуОшибки) Тогда
			Рекомендации.Добавить(РекомендацияПоКодуОшибки);
		КонецЕсли;
	КонецЕсли;

	Рекомендации.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Повторить попытку позднее (возможно временные неполадки на сервисе). Обратиться в поддержку сервиса %1.'"),
		Объект.Сервис));
	Рекомендации.Добавить(НСтр("ru='Выбрать другой сервис для синхронизации файлов.'"));
	
	ТекстОшибок = СтрСоединить(Ошибки, Символы.ПС);
	ТекстРекомендаций = ТекстРекомендаций(Рекомендации);
	ТекстПротокола = СтрСоединить(ЭлементыПротокола, Символы.ПС);
	Если НЕ ЗначениеЗаполнено(КодОшибки) Тогда
		КодОшибки = НСтр("ru='- (не определен)'");
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("КодОшибки", КодОшибки);
	Результат.Вставить("Ошибки", ТекстОшибок);
	Результат.Вставить("Рекомендации", ТекстРекомендаций);
	Результат.Вставить("Протокол", ТекстПротокола);
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ДобавитьЭлементПротокола(ЭлементыПротокола, ЗаголовокЭлемента, ТекстЭлемента)
	Если НЕ ЗначениеЗаполнено(ТекстЭлемента) Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЭлементыПротокола) Тогда
		ЭлементыПротокола.Добавить();
	КонецЕсли;
	ЭлементыПротокола.Добавить(ЗаголовокЭлемента);
	ЭлементыПротокола.Добавить(ТекстЭлемента);
КонецПроцедуры

&НаКлиенте
Функция ТекстРекомендаций(Рекомендации)
	РекомендацииНаВывод = Новый Массив();
	Для ИндексРекомендации = 0 По Рекомендации.ВГраница() Цикл
		НомерРекомендации = ИндексРекомендации + 1;
		ТекстРекомендации = Рекомендации[ИндексРекомендации];
		РекомендацияНаВывод = СтрШаблон("    %1. %2", НомерРекомендации, ТекстРекомендации); 
		РекомендацииНаВывод.Добавить(РекомендацияНаВывод);
	КонецЦикла;
	Результат = СтрСоединить(РекомендацииНаВывод, Символы.ПС);
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КодОшибкиИзПротоколаПроверки(ПротоколПроверки)
	КодСтрокой = "";
	Контроль = "HTTP RESPONSE";
	Если СтрНайти(ПротоколПроверки, Контроль) > 0 Тогда
		Для НомерСтроки = 1 По СтрЧислоСтрок(ПротоколПроверки) Цикл
			ТекстСтроки = СтрПолучитьСтроку(ПротоколПроверки, НомерСтроки);
			Если СтрНайти(ТекстСтроки, Контроль) > 0 Тогда
				КодСтрокой = СокрЛП(СтрЗаменить(ТекстСтроки, Контроль, ""));
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ЗначениеЗаполнено(КодСтрокой) Тогда
		Результат = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КодСтрокой);
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция РекомендацияПоКодуОшибки(КодОшибки)
	Если КодОшибки = 404 Тогда
		Результат = НСтр("ru = 'Проверить, что указанная корневая папка существует в облачном сервисе.'");
	ИначеЕсли КодОшибки = 401 Тогда
		Результат = НСтр("ru = 'Проверить правильность введенных логина и пароля.'");
	ИначеЕсли КодОшибки = 501 Тогда
		// На сервере не реализован один из методов протокола WebDAV
	Иначе
		Результат = НСтр("ru = 'Проверьте правильность введенных данных.'");
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ВызовСервера

&НаСервереБезКонтекста
Функция ВыполнитьПроверкуПодключения(Знач УчетнаяЗапись)
	Результат = Неопределено;
	РаботаСФайламиСлужебный.ВыполнитьПроверкуПодключения(УчетнаяЗапись, Результат);
	Возврат Результат; 
КонецФункции

&НаСервереБезКонтекста
Функция ДиагностикаСоединения(Знач Сервис)
	Результат = Неопределено;
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
		МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
		Результат = МодульПолучениеФайловИзИнтернета.ДиагностикаСоединения(Сервис);
	КонецЕсли;
	Возврат Результат;
