#Область ОтображениеСекретныхДанныхНаФорме

// Устанавливает видимость кнопки отображения символов.
//
// Параметры:
//  Элемент  - ПолеФормы - элемент формы с секретными данными.
//
Процедура ПриИзмененииСекретныхДанных(Элемент) Экспорт
	
	Если Элемент.КнопкаВыбора = Неопределено Тогда
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыВидны;
		Элемент.КнопкаВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Изменяет режим отображения символов поля с секретными данными.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой обрабатываются секретные данные.
//  Элемент - ПолеФормы - элемент формы с секретными данными.
//  ИмяРеквизита - Строка - имя реквизита формы для обновления данных.
//
Процедура ОтобразитьСекретныеДанные(Форма, Элемент, ИмяРеквизита) Экспорт
	
	Элемент.РежимПароля = Не Элемент.РежимПароля;
	Форма[ИмяРеквизита] = Элемент.ТекстРедактирования;
	Если Элемент.РежимПароля Тогда
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыВидны;
	Иначе
		Элемент.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыСкрыты;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтправкаСообщенияВМессенджеры

// Описание новых параметров отправки в мессенджеры.
//
// Возвращаемое значение:
//  Структура - описывает параметры отправки в мессенджеры.
//    * Мессенджер - Строка - идентификатор мессенджера, может принимать следующие значения:
//      "Телеграм", "WhatsApp".
//    * Получатель - Строка - контактные данные получателя.
//    * СписокПолучателей - СписокЗначений - список контактных данных из которых необходимо произвести выбор.
//
Функция НовыйПараметрыОтправкиВМессенджеры() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Мессенджер", "");
	Результат.Вставить("Получатель", "");
	Результат.Вставить("СписокПолучателей", Новый СписокЗначений);
	
	Возврат Результат;
	
КонецФункции

// Инициализирует процесс открытия URL для передачи сообщения пользователю посредством мессенджеров.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения для пользователя.
//  СсылкаДляПередачи - Строка - URL для пользователя.
//  ПараметрыОтправки - Структура - Описывает параметры отправки сообщения
//    * Мессенджер - Строка - идентификатор мессенджера, может принимать следующие значения:
//      "Телеграм", "WhatsApp".
//    * Получатель - Строка - контактные данные получателя (не учитываются для Телеграм).
//    * СписокПолучателей - СписокЗначений - список контактных данных
//      из которых необходимо произвести выбор(не учитываются для Телеграм).
//
Процедура ОткрытьURLОтправкиВМессенджеры(ТекстСообщения, СсылкаДляПередачи, ПараметрыОтправки) Экспорт
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.СписокПолучателей) Тогда
		
		ПараметрыСообщения = Новый Структура;
		ПараметрыСообщения.Вставить("ТекстСообщения", ТекстСообщения);
		ПараметрыСообщения.Вставить("СсылкаДляПередачи", СсылкаДляПередачи);
		ПараметрыСообщения.Вставить("ПараметрыОтправки", ПараметрыОтправки);
		
		ПараметрыОтправки.СписокПолучателей.ПоказатьВыборЭлемента(
				Новый ОписаниеОповещения(
					"ПриВыбореПолучателяСообщенияДляМессенджера",
					ЭтотОбъект,
					ПараметрыСообщения),
				НСтр("ru = 'Выбор получателя сообщения'"));
	Иначе
		ОткрытьURLОтправкиВМессенджерыЗавершение(ТекстСообщения, СсылкаДляПередачи, ПараметрыОтправки);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет обработку выбора получателя пользователем,
// продолжает процесс открытия URL для передачи сообщения пользователю посредством мессенджеров.
//
Процедура ПриВыбореПолучателяСообщенияДляМессенджера(ВыбранныйЭлемент, ПараметрыСообщения) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		ПараметрыСообщения.ПараметрыОтправки.Получатель = ВыбранныйЭлемент.Значение;
	КонецЕсли;
	
	ОткрытьURLОтправкиВМессенджерыЗавершение(
		ПараметрыСообщения.ТекстСообщения,
		ПараметрыСообщения.СсылкаДляПередачи,
		ПараметрыСообщения.ПараметрыОтправки);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСБуферомОбмена

// Выполняет попытку помещения строки в буфер обмена.
//
// Параметры:
//  Текст - Строка - текст для помещения в буфер.
//
// Возвращаемое значение:
//  Булево - результат помещения в буфер. Истина если помещение выполнено успешно.
//
Асинх Функция ПоместитьСтрокуВБуферОбмена(Текст) Экспорт
	
	Если СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		ФорматДанных = СтандартныйФорматДанныхБуфераОбмена.Текст;
		Если Ждать СредстваБуфераОбмена.ПоддерживаетсяФорматДанных(ФорматДанных) Тогда
			ПомещаемыеДанные = Новый ЭлементБуфераОбмена(ФорматДанных, Текст);
			Возврат Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ПомещаемыеДанные);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область АутентификацияВСервисахИнтернетПоддержки

// Обработка оповещения недоступности подключения Интернет-поддержки.
//
// Параметры:
//  ОповещениеОЗавершении - ОписаниеОповещения - оповещение для вызова.
//
Процедура ПриНедоступностиПодключенияИПП(ОповещениеОЗавершении) Экспорт

	Если ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ОповещениеОЗавершении, Неопределено);
	КонецЕсли;

КонецПроцедуры

// См. ИнтернетПоддержкаПользователейВызовСервера.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки
//
Функция ПроверитьПодключениеИнтернетПоддержкиПользователей()
	
	Возврат ИнтернетПоддержкаПользователейВызовСервера.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки();
	
КонецФункции

// Выполняет вызов вопроса пользователю оповещения после окончания процесса подключения ИПП
//
// Параметры:
//  ОбработкаЗавершения - ОписаниеОповещения - Содержит описание оповещения,
//   которое необходимо вызвать после ответа пользователя.
//  ВопросПользователю - Строка, Неопределено - текст вопроса пользователю
//
Процедура ПоказатьВопросПодключенияИнтернетПоддержкиПользователей(
		Знач ОбработкаЗавершения,
		Знач ВопросПользователю)
	
	Параметры = Новый Структура;
	Параметры.Вставить("ОбработкаЗавершения", ОбработкаЗавершения);
	
	ОбработкаОтвета = Новый ОписаниеОповещения("ПоказатьВопросПодключенияИнтернетПоддержкиПользователейЗавершение", ЭтотОбъект, Параметры);
	
	Если ЗначениеЗаполнено(ВопросПользователю) Тогда
		ТекстВопроса = ВопросПользователю;
	Иначе
		ТекстВопроса = НСтр("ru='Подключение к Интернет-поддержке пользователей не обнаружено.
			|Подключиться сейчас?'");
	КонецЕсли;
	
	ПоказатьВопрос(ОбработкаОтвета, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

// Выполняет вызов обработки оповещения после окончания процесса подключения ИПП
//
// Параметры:
//  Ответ - КодВозвратаДиалога - Содержит ответ пользователя.
//  Параметры - Структура - содержит описание оповещения при закрытии формы.
//
Процедура ПоказатьВопросПодключенияИнтернетПоддержкиПользователейЗавершение(
		Знач Ответ,
		Знач Параметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ОбработкаПодключения = Новый ОписаниеОповещения(
			"НачатьПодключениеИнтернетПоддержкиПользователейЗавершение",
			ЭтотОбъект,
			Параметры);
		НачатьПодключениеИнтернетПоддержкиПользователей(ОбработкаПодключения);
		
	Иначе
		
		Если Параметры.ОбработкаЗавершения <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(Параметры.ОбработкаЗавершения, Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей
//
Процедура НачатьПодключениеИнтернетПоддержкиПользователей(
		Знач ОбработкаПодключения = Неопределено)
	
	ПодключитьИнтернетПоддержкуПользователей(
		ОбработкаПодключения,
		ЭтотОбъект);
	
КонецПроцедуры

// Выполняет вызов обработки оповещения после окончания процесса подключения ИПП
//
// Параметры:
//  ДанныеПодключения - Структура - Содержит данные аутентификации пользователя,
//    пустая если они не заданы.
//  Параметры - Структура - содержит описание оповещения при закрытии формы
//
Процедура НачатьПодключениеИнтернетПоддержкиПользователейЗавершение(
		Знач ДанныеПодключения,
		Знач Параметры) Экспорт
	
	Если Параметры.ОбработкаЗавершения <> Неопределено Тогда
		
		Подключено = (ДанныеПодключения <> Неопределено);
		ВыполнитьОбработкуОповещения(Параметры.ОбработкаЗавершения, Подключено);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОтправкаСообщенияВМессенджеры

// Выполняет открытие URL для передачи сообщения пользователю посредством мессенджеров.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения для пользователя.
//  СсылкаДляПередачи - Строка - URL для пользователя.
//  ПараметрыОтправки - Структура - Описывает параметры отправки сообщения
//    * Мессенджер - Строка - идентификатор мессенджера, может принимать следующие значения:
//      "Телеграм", "WhatsApp".
//    * Получатель - Строка - контактные данные получателя (не учитываются для Телеграм).
//    * СписокПолучателей - СписокЗначений - список контактных данных
//      из которых необходимо произвести выбор(не учитываются для Телеграм).
//
Процедура ОткрытьURLОтправкиВМессенджерыЗавершение(
		Знач ТекстСообщения,
		СсылкаДляПередачи,
		ПараметрыОтправки)
	
	Если ЗначениеЗаполнено(ПараметрыОтправки.Получатель) Тогда
		ПараметрыОтправки.Получатель = СтрЗаменить(ПараметрыОтправки.Получатель, "-", "");
		ПараметрыОтправки.Получатель = СтрЗаменить(ПараметрыОтправки.Получатель, " ", "");
		ПараметрыОтправки.Получатель = СтрЗаменить(ПараметрыОтправки.Получатель, "+", "");
	КонецЕсли;
	
	Если ПараметрыОтправки.Мессенджер = "Телеграм" Тогда
		ТекстСообщения = СтрЗаменить(ТекстСообщения, Символы.ПС, "%20");
		ОткрытьURLОтправкиВТелеграм(
			ТекстСообщения,
			ИнтернетПоддержкаПользователейВызовСервера.СтрокаВURLКодировке(СсылкаДляПередачи));
	ИначеЕсли ПараметрыОтправки.Мессенджер = "WhatsApp" Тогда
		ОткрытьURLОтправкиВWhatsApp(
			ИнтернетПоддержкаПользователейВызовСервера.СтрокаВURLКодировке(ТекстСообщения),
			ПараметрыОтправки.Получатель);
	КонецЕсли;
	
КонецПроцедуры

// Выполняет открытие URL для передачи ссылки пользователю посредством Telegram.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения для пользователя.
//  СсылкаДляПередачи - Строка - URL для получателя.
//
// Возвращаемое значение:
//  Строка - Ссылка для передачи сообщения пользователю посредством WhatsApp.
//
Процедура ОткрытьURLОтправкиВТелеграм(
		ТекстСообщения,
		СсылкаДляПередачи)
	
	URLОтправки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		"https://t.me/share/url?url=%1&text=%2",
		СсылкаДляПередачи,
		ТекстСообщения);
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(URLОтправки);
	
КонецПроцедуры

// Выполняет открытие URL для передачи ссылки пользователю посредством WhatsApp.
//
// Параметры:
//  ТекстСообщения - Строка - текст сообщения для пользователя.
//  Получатель - Строка -  телефон получателя сообщения
//
// Возвращаемое значение:
//  Строка - Ссылка для передачи сообщения пользователю посредством WhatsApp.
//
Процедура ОткрытьURLОтправкиВWhatsApp(
	ТекстСообщения,
	Получатель)
	
	Если ЗначениеЗаполнено(Получатель) Тогда
		URLОтправки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"https://api.whatsapp.com/send?phone=%1&text=%2",
			Получатель,
			ТекстСообщения);
	Иначе
		URLОтправки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"https://api.whatsapp.com/send/?text=%1",
			ТекстСообщения);
	КонецЕсли;
	
	ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(URLОтправки);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
