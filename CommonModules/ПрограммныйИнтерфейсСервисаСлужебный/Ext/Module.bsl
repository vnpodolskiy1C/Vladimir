		"КодАбонентаВладельца", ОбщегоНазначения.ОписаниеТипаЧисло(12, 0, ДопустимыйЗнак.Неотрицательный)));
	Переименования.Вставить("application", ОписаниеКолонки(
		"КодКонфигурации", ОбщегоНазначения.ОписаниеТипаСтрока(22)));
	Переименования.Вставить("app_version", ОписаниеКолонки(
		"ВерсияКонфигурации", ОбщегоНазначения.ОписаниеТипаСтрока(18)));
	Переименования.Вставить("app_name", ОписаниеКолонки(
		"НаименованиеКонфигурации", ОбщегоНазначения.ОписаниеТипаСтрока(64)));
	Переименования.Вставить("apptype_id", ОписаниеКолонки(
		"КодВидаПриложения", ОбщегоНазначения.ОписаниеТипаСтрока(22)));
	Переименования.Вставить("apptype_name", ОписаниеКолонки(
		"ИмяВидаПриложения", ОбщегоНазначения.ОписаниеТипаСтрока(255)));
	Переименования.Вставить("apptype_presentation", ОписаниеКолонки(
		"НаименованиеВидаПриложения", ОбщегоНазначения.ОписаниеТипаСтрока(150)));
	Переименования.Вставить("status", ОписаниеКолонки(
		"СостояниеПриложения", Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияПриложений")));
	Переименования.Вставить("url", ОписаниеКолонки(
		"АдресПриложения", ОбщегоНазначения.ОписаниеТипаСтрока(500)));
	Переименования.Вставить("user_language", ОписаниеКолонки(
		"КодЯзыкаПользователя", ОбщегоНазначения.ОписаниеТипаСтрока(10)));
	Переименования.Вставить("timezone", ОписаниеКолонки(
		"ЧасовойПояс", ОбщегоНазначения.ОписаниеТипаСтрока(100)));
	Переименования.Вставить("platform", ОписаниеКолонки(
		"ВерсияПлатформы", ОбщегоНазначения.ОписаниеТипаСтрока(18)));
	Переименования.Вставить("size", ОписаниеКолонки(
		"РазмерПриложения", ОбщегоНазначения.ОписаниеТипаЧисло(15, 0, ДопустимыйЗнак.Неотрицательный)));
	Переименования.Вставить("size_calc_date", ОписаниеКолонки(
		"ДатаРасчетаРазмераПриложения", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя)));

	Возврат Переименования;
	
КонецФункции

