 // Возвращает код абонента текущего приложения
// 
// Возвращаемое значение:
//  Число - Код абонента
Функция КодАбонента() Экспорт
	
	КодАбонента = 0;
	
	РазделениеВключено = РаботаВМоделиСервиса.РазделениеВключено();
	Если РазделениеВключено Тогда
		КодАбонента = РаботаВМоделиСервисаСлужебныйПовтИсп.КодАбонента();
		Если КодАбонента = 0 Тогда
			КодАбонента = АбонентЭтогоПриложения().Код;
		КонецЕсли;
	Иначе
		КодАбонента = ДанныеАвторизацииВСервисе().КодАбонента;
	КонецЕсли;
	
	Возврат КодАбонента;
	
КонецФункции
  
