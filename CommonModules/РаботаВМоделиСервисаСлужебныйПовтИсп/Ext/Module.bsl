// Параметры:
//  ИмяРасширения - Строка
// 
// Возвращаемое значение:
//  ОбъектМетаданныхКонфигурация
Функция МетаданныеПодключенногоРасширения(ИмяРасширения) Экспорт
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	НайденныеРасширения = РасширенияКонфигурации.Получить(Новый Структура("Имя", ИмяРасширения));
	Если НайденныеРасширения.Количество() = 0 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Расширение ""%1"" не найдено.'"), ИмяРасширения);
	КонецЕсли;
	
	МетаданныеРасширения = Новый ОбъектМетаданныхКонфигурация(НайденныеРасширения[0].ПолучитьДанные());
	
	Возврат МетаданныеРасширения;
	
КонецФункции

// Параметры:
//  ИмяРасширения - Строка
// 
// Возвращаемое значение:
//  Булево
Функция РасширениеПоддерживаетИсториюДанных(ИмяРасширения) Экспорт
	
	МетаданныеРасширения = РаботаВМоделиСервисаСлужебныйПовтИсп.МетаданныеПодключенногоРасширения(ИмяРасширения);
	РежимСовместимости = МетаданныеРасширения.РежимСовместимостиРасширенияКонфигурации;
	
	Если РежимСовместимости = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	НеПоддерживающиеРежимыСовместимости = Новый Массив();
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_1);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_13);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_2_16);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_1);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_2);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_3);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_4);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_5);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_6);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_7);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_8);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_9);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_10);
	НеПоддерживающиеРежимыСовместимости.Добавить(Метаданные.СвойстваОбъектов.РежимСовместимости.Версия8_3_11);
	
	Возврат НеПоддерживающиеРежимыСовместимости.Найти(РежимСовместимости) = Неопределено;
	
