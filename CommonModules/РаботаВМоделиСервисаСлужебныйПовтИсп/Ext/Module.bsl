// Новый дополнительные данные.
// 
// Параметры:
//  Имя - Строка - Имя
//  Разделитель - Строка - Разделитель
//  УсловноеРазделение - ОбъектМетаданныхКонстанта, Булево, Неопределено - Условное разделение
// 
// Возвращаемое значение:
//  Структура - Новый дополнительные данные:
// * Имя - Строка - Имя 
// * Разделитель - Строка - Разделитель 
// * УсловноеРазделение - ОбъектМетаданныхКонстанта, Булево, Неопределено - УсловноеРазделение 
Функция НовыйДополнительныеДанные(Имя, Разделитель, УсловноеРазделение = Неопределено)
	
	ДополнительныеДанные = Новый Структура;
	ДополнительныеДанные.Вставить("Имя", Имя);
	ДополнительныеДанные.Вставить("Разделитель", Разделитель);
	ДополнительныеДанные.Вставить("УсловноеРазделение", УсловноеРазделение);
	
	Возврат ДополнительныеДанные;
	
КонецФункции

// Новый элемент состава.
// 
// Параметры:
//  Метаданные - ОбъектМетаданных - Метаданные
//  Использование - ИспользованиеОбщегоРеквизита - Использование
//  УсловноеРазделение - ОбъектМетаданныхКонстанта, Булево - Условное разделение
// 
// Возвращаемое значение:
//  Структура - Новый элемент состава:
// * Метаданные - ОбъектМетаданных - Метаданные 
// * Использование - ИспользованиеОбщегоРеквизита - Использование 
// * УсловноеРазделение - ОбъектМетаданныхКонстанта, Булево - УсловноеРазделение 
Функция НовыйЭлементСостава(Метаданные, Использование, УсловноеРазделение)
	
	НовыйЭлементСостава = Новый Структура;
	НовыйЭлементСостава.Вставить("Метаданные", Метаданные);
	НовыйЭлементСостава.Вставить("Использование", Использование);
	НовыйЭлементСостава.Вставить("УсловноеРазделение", УсловноеРазделение);
	
	Возврат НовыйЭлементСостава;

КонецФункции

#КонецОбласти
