// Возвращает признак, что начат процесс завершения резервного копирования области данных.
//
// Возвращаемое значение:
//  Булево
//
Функция ВыполняетсяЗавершениеВыгрузкиВТранзакции() Экспорт
	
	Ключ = КлючЗавершенияВыгрузкиВТранзакции();
	МаксПопытокПроверкиЗавершенияРК = 100;
	Для НомерПопытки = 1 По МаксПопытокПроверкиЗавершенияРК Цикл
		
		// Проверка выполняется в цикле, т.к. при параллельном выполнении в разных транзакциях, может возникнуть ситуация,
		// что два проверяющих сеанса пересекутся на блокировке ключа, первый проверяющий заблокирует и второй проверяющий
		// тоже попытается заблокировать, до того момента, пока первый разблокировал ключ. Такое может происходить
		// из-за того, что метод "ЗаблокироватьДанныеДляРедактирования" не имеет ожидания.
		//
		// Использование управляемой блокировки невозможно, т.к. при ошибке ее установки родительская транзакция
		// будет считаться "сломанной".
		
		ВыполняетсяЗавершениеРК = Ложь;
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Ключ);
			РазблокироватьДанныеДляРедактирования(Ключ);
		Исключение
			ВыполняетсяЗавершениеРК = Истина;
		КонецПопытки;
		
		Если Не ВыполняетсяЗавершениеРК Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВыполняетсяЗавершениеРК;
	
КонецФункции

// Устанавливает признак, что начат процесс завершения резервного копирования области данных.
//
Процедура НачатьЗавершениеВыгрузкиВТранзакции() Экспорт
	
	ЗаблокироватьДанныеДляРедактирования(КлючЗавершенияВыгрузкиВТранзакции());
	
