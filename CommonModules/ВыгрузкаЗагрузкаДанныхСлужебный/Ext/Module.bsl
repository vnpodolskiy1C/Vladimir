		И Не ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
	Параметры = Новый Структура();
	Параметры.Вставить("ДоступноИспользование", ДоступноИспользование);
	Параметры.Вставить("КоличествоПотоков", 4);
	
