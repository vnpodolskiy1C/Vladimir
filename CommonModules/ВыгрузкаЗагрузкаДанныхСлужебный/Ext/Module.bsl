#Область Функциональность1СПлюс

Функция ПолучитьМодуль1СПлюс() Экспорт
	
	ИмяПодсистемы = "ПлюсСервис";
	
	Если ОбщегоНазначения.ПодсистемаСуществует(ИмяПодсистемы) Тогда
		 
		МодульПлюсСервис = ОбщегоНазначения.ОбщийМодуль(ИмяПодсистемы);
		
		Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(МодульПлюсСервис.ВерсияБиблиотеки(), "1.0.0.4") >= 0 Тогда
			Возврат МодульПлюсСервис;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

