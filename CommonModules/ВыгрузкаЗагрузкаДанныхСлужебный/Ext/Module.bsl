// Ожидает выгрузку загрузку данных в потоках.
// 
// Параметры:
//  Задания - Массив из ФоновоеЗадание - Запущенные задания
//  ПараметрыПроцесса - Структура - Для загрузки данных см. обработку ВыгрузкаЗагрузкаДанныхМенеджерЗагрузкиДанныхИнформационнойБазы.НовыеПараметрыПроцессаЗагрузкиДанныхИнформационнойБазы
//									Для выгрузки данных см. обработку ВыгрузкаЗагрузкаДанныхМенеджерВыгрузкиДанныхИнформационнойБазы.НовыеПараметрыПроцессаВыгрузкиДанныхИнформационнойБазы
Процедура ОжидатьВыгрузкуЗагрузкуДанныхВПотоках(Задания, ПараметрыПроцесса) Экспорт
	
	УправляющееЗадание = ПолучитьЗаданиеПараллельнойВыгрузкиЗагрузкиДанных();
	ИдентификаторЗадания = УправляющееЗадание.УникальныйИдентификатор;
	
	ТаймаутОжиданияЗаданий = 1; // сек.
	ПериодичностьЗапускаДополнительныхПотоков = 10000; // 10 сек.
	
	ТаблицаСообщений = Неопределено;
	ДатаПоследнегоЗапускаДополнительныхПотоков = ТекущаяУниверсальнаяДатаВМиллисекундах() - ПериодичностьЗапускаДополнительныхПотоков;
	
	Контейнер = ПараметрыПроцесса.Контейнер; // ОбработкаОбъект.ВыгрузкаЗагрузкаДанныхМенеджерКонтейнера
	ИдентификаторПроцесса = Контейнер.ИдентификаторПроцесса();
	
	Пока Истина Цикл
		
		Если ТекущаяУниверсальнаяДатаВМиллисекундах() - ДатаПоследнегоЗапускаДополнительныхПотоков >= ПериодичностьЗапускаДополнительныхПотоков Тогда
			ДатаПоследнегоЗапускаДополнительныхПотоков = ТекущаяУниверсальнаяДатаВМиллисекундах();
			ЗапуститьДополнительныеПотокиВыгрузкиЗагрузкиДанных(Задания, ПараметрыПроцесса);
		КонецЕсли;
		
		// Если задания еще ничего не отправило, то засыпаем на время таймаута, чтобы в холостую не выполнять обработку данных от заданий
		Если Не ЗначениеЗаполнено(ТаблицаСообщений) Тогда
			Задания = ФоновыеЗадания.ОжидатьЗавершенияВыполнения(Задания, ТаймаутОжиданияЗаданий);
		КонецЕсли;
		
		НомерЗадания = Задания.Количество();
		
		Ошибки = Новый Массив();
		ЗавершенныеЗадания = Новый Массив();
		ТаблицаСообщений = НоваяТаблицаСообщенийПотоков();
		
		Пока НомерЗадания > 0 Цикл
			
			НомерЗадания = НомерЗадания - 1;
			Задание = Задания[НомерЗадания];
			
			Если Задание.Состояние <> СостояниеФоновогоЗадания.Активно Тогда
				Задания.Удалить(НомерЗадания);
			КонецЕсли;
			
			ПолучитьСообщенияПотока(ТаблицаСообщений, Задание, ИдентификаторПроцесса);
			
			ТекстОшибки = Неопределено;
			
			Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
				
				ИнформацияОбОшибке = ?(Задание.ИнформацияОбОшибке = Неопределено,
					НСтр("ru = 'Отсутствует информация об ошибке.'"),
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(Задание.ИнформацияОбОшибке));
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Поток %1, фоновое задание завершилось аварийно.
						 |%2'"),
					НомерПотокаИзКлючаЗадания(Задание.Ключ),
					ИнформацияОбОшибке);
				
			ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
				
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Поток %1, фоновое задание отменено.'"),
					НомерПотокаИзКлючаЗадания(Задание.Ключ));
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстОшибки) Тогда
				
				Ошибки.Добавить(ТекстОшибки);
				
				ПослеЗавершенияПотокаВыгрузкиЗагрузкиДанных(Задание.УникальныйИдентификатор);
				
			ИначеЕсли ЗаданиеПотокаЗавершено(Задание, ТаблицаСообщений) Тогда
				
				 ЗавершенныеЗадания.Добавить(НомерЗадания);
				 
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Ошибки) Тогда
			
			ЗавершенныеЗадания.Очистить();
			
			Для Каждого Задание Из Задания Цикл
				
				ТекстОшибки = СтрШаблон(
					НСтр("ru = 'Поток %1, фоновое задание прервано из-за ошибки в другом потоке.'"),
					НомерПотокаИзКлючаЗадания(Задание.Ключ));
				
				Задание.Отменить();
				Ошибки.Добавить(ТекстОшибки);
				
				ПолучитьСообщенияПотока(ТаблицаСообщений, Задание, ИдентификаторПроцесса);
				
				ПослеЗавершенияПотокаВыгрузкиЗагрузкиДанных(Задание.УникальныйИдентификатор);
				
			КонецЦикла;
			
			ОбработатьСообщенияПотоков(ТаблицаСообщений, Контейнер);
			
			ПослеЗавершенияПотокаВыгрузкиЗагрузкиДанных(ИдентификаторЗадания);
			
			РазделительОшибок = Символы.ПС + Символы.ПС;
			ТекстОшибки = СтрСоединить(Ошибки, РазделительОшибок);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
		ОбработатьСообщенияПотоков(ТаблицаСообщений, Контейнер);
		
		Для Каждого НомерЗадания Из ЗавершенныеЗадания Цикл
			Задание = Задания[НомерЗадания];
			Задания.Удалить(НомерЗадания);
			Задание.Отменить();
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(Задания) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	ПослеЗавершенияПотокаВыгрузкиЗагрузкиДанных(ИдентификаторЗадания);
	
КонецПроцедуры

// Возвращаемое значение:
//  Структура:
// * ЭтоВыгрузка - Булево
// * ЭтоЗагрузка - Булево
// * КоличествоПотоков - Число
// * ВидПотоков - см. ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени
// * Параметры - Структура
Функция НовыеПараметрыПотоковВыгрузкиЗагрузкиДанных() Экспорт
	
	ПараметрыПотока = Новый Структура();
	ПараметрыПотока.Вставить("ЭтоВыгрузка", Ложь);
	ПараметрыПотока.Вставить("ЭтоЗагрузка", Ложь);
	ПараметрыПотока.Вставить("КоличествоПотоков", 0);
	ПараметрыПотока.Вставить("ВидПотоков", ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени("Дополнительный"));
	ПараметрыПотока.Вставить("Параметры", Новый Структура());
	
	Возврат ПараметрыПотока;
	
КонецФункции

// Выгрузка загрузка данных информационной базы в потоке.
// 
// Параметры:
//  ПараметрыПотока - см. ВыгрузкаЗагрузкаДанныхСлужебный.ВыгрузкаЗагрузкаДанныхИнформационнойБазыВПотоке
Процедура ВыгрузкаЗагрузкаДанныхИнформационнойБазыВПотоке(ПараметрыПотока) Экспорт
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	
	Если ПараметрыПотока.ЭтоВыгрузка Тогда
		
		Обработки.ВыгрузкаЗагрузкаДанныхМенеджерВыгрузкиДанныхИнформационнойБазы.ВыгрузитьДанныеИнформационнойБазыВПотоке(
			ПараметрыПотока.Параметры);
		
	ИначеЕсли ПараметрыПотока.ЭтоЗагрузка Тогда
		
		МодульУправлениеДоступом = Неопределено;
		
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
			МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
			МодульУправлениеДоступом.ОтключитьОбновлениеКлючейДоступа(Истина, Ложь);
		КонецЕсли;
		
		Попытка
			
			Обработки.ВыгрузкаЗагрузкаДанныхМенеджерЗагрузкиДанныхИнформационнойБазы.ЗагрузитьДанныеИнформационнойБазыВПотоке(
				ПараметрыПотока.Параметры);
			
			Если МодульУправлениеДоступом <> Неопределено Тогда
				МодульУправлениеДоступом.ОтключитьОбновлениеКлючейДоступа(Ложь);
			КонецЕсли;
			
		Исключение
			
			Если МодульУправлениеДоступом <> Неопределено Тогда
				МодульУправлениеДоступом.ОтключитьОбновлениеКлючейДоступа(Ложь);
			КонецЕсли;
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	Иначе
		
		ВызватьИсключение НСтр("ru = 'Некорректные параметры потока.'");
		
	КонецЕсли;
	
КонецПроцедуры

// Отправить сообщение в родительский поток.
// 
// Параметры:
//  Контейнер - ОбработкаОбъект.ВыгрузкаЗагрузкаДанныхМенеджерКонтейнера - Текущий контейнер
//  ИмяМетода - Строка - Имя метода
//  ДанныеСообщения - Структура - Данные сообщения
Процедура ОтправитьСообщениеВРодительскийПоток(Контейнер, ИмяМетода, ДанныеСообщения) Экспорт
	
	Если Не Контейнер.КлиентскийСеансСуществует() Тогда
		Контейнер.ПрерватьПроцессПриОтсутствииКлиентскогоСеанса();
	КонецЕсли;
	
	СообщениеПотока = Новый Структура();
	СообщениеПотока.Вставить("ДатаОтправки", ТекущаяУниверсальнаяДатаВМиллисекундах());
	СообщениеПотока.Вставить("НомерСообщения", Контейнер.СледующийНомерСообщенияВПотоке());
	СообщениеПотока.Вставить("ИмяМетода", ИмяМетода);
	СообщениеПотока.Вставить("ДанныеСообщения", ДанныеСообщения);
	
	ЗаписьДанныхСообщения = Новый ЗаписьJSON();
	ЗаписьДанныхСообщения.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьДанныхСообщения, СообщениеПотока);
	
	Сообщение = Новый СообщениеПользователю();
	Сообщение.ИдентификаторНазначения = Контейнер.ИдентификаторПроцесса();
	Сообщение.Текст = ЗаписьДанныхСообщения.Закрыть();
	Сообщение.Сообщить();
	
КонецПроцедуры

// Получить задание параллельной выгрузки загрузки данных.
// 
// Возвращаемое значение:
//  ФоновоеЗадание, Неопределено -
Функция ПолучитьЗаданиеПараллельнойВыгрузкиЗагрузкиДанных() Экспорт
	
	Задание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	
	Если Задание = Неопределено Тогда
		ВызватьИсключение НСтр(
			"ru = 'Параллельная выгрузка\загрузка данных может выполняться только в фоновом задании.'");
	КонецЕсли;
	
	Возврат Задание;
	
КонецФункции

// Параметры:
//  Контейнер - ОбработкаОбъект.ВыгрузкаЗагрузкаДанныхМенеджерКонтейнера
// 
// Возвращаемое значение:
//  см. ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени
Функция ВидПотокаПараллельнойВыгрузкиЗагрузкиДанных(Контейнер) Экспорт
	
	ИмяВидаПотока = ?(Контейнер.КоличествоПотоков() = 1, "Основной", "Дополнительный");
	
	Возврат ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени(ИмяВидаПотока);
	
КонецФункции

// Параметры:
//  Задание - ФоновоеЗадание
//  Контейнер - ОбработкаОбъект.ВыгрузкаЗагрузкаДанныхМенеджерКонтейнера
//  ВидПотока - см. ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени
Процедура ПослеЗапускаПотокаВыгрузкиЗагрузкиДанных(Задание, Контейнер, ВидПотока) Экспорт
	
	Возврат;
	
КонецПроцедуры

// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
Процедура ПослеЗавершенияПотокаВыгрузкиЗагрузкиДанных(ИдентификаторЗадания) Экспорт
	
	Возврат;
	
КонецПроцедуры

// Параметры:
//  ИдентификаторЗадания - УникальныйИдентификатор
// 
// Возвращаемое значение:
//  Булево
Функция НужноЗавершитьПотокВыгрузкиЗагрузкиДанных(ИдентификаторЗадания) Экспорт
	
	Возврат Ложь;
	
КонецФункции

// Параметры:
//  ИмяВидаЗадания - Строка
// 
// Возвращаемое значение:
//  Неопределено
Функция ВидЗаданияВыгрузкиЗагрузкиДанныхПоИмени(ИмяВидаЗадания) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

// Параметры:
//  ИмяВидаПотока - Строка
// 
// Возвращаемое значение:
//  Неопределено
Функция ВидПотокаВыгрузкиЗагрузкиДанныхПоИмени(ИмяВидаПотока) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СостояниеВыгрузкиЗагрузки

Функция НеобходимоПодсчитыватьКоличествоОбъектов(ПараметрыВыгрузкиЗагрузки) Экспорт
	
	Возврат НеобходимоФиксироватьСостояниеВыгрузкиЗагрузкиОбластиДанных(ПараметрыВыгрузкиЗагрузки)
		Или ИспользоватьМногопоточность(ПараметрыВыгрузкиЗагрузки);
	
КонецФункции

Функция НеобходимоФиксироватьСостояниеВыгрузкиЗагрузкиОбластиДанных(ПараметрыВыгрузкиЗагрузки) Экспорт
	
	Если Не ЗначениеЗаполнено(ПараметрыВыгрузкиЗагрузки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИдентификаторСостояния = Неопределено;
	ПараметрыВыгрузкиЗагрузки.Свойство("ИдентификаторСостояния", ИдентификаторСостояния);
	
	Возврат ЗначениеЗаполнено(ИдентификаторСостояния);
	
КонецФункции

Функция СостояниеВыгрузкиЗагрузкиОбластиДанных(ИдентификаторСостояния) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Идентификатор", ИдентификаторСостояния);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ОбластьДанныхВспомогательныеДанные КАК ОбластьДанных,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ЗагрузкаОбластиДанных КАК ЗагрузкаОбластиДанных,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ПроцентЗавершения КАК ПроцентЗавершения,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.РасчетнаяДатаЗавершения КАК РасчетнаяДатаЗавершения,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ИмяОбрабатываемогоОбъектаМетаданных КАК ИмяОбрабатываемогоОбъектаМетаданных,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ОбработаноОбъектов КАК ОбработаноОбъектов,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ОбработаноОбъектовДоТекущегоОбъектаМетаданных КАК
	|		ОбработаноОбъектовДоТекущегоОбъектаМетаданных,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ДатаНачала КАК ДатаНачала,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ДатаНачалаОбработкиОбъектов <> ДАТАВРЕМЯ(1, 1, 1) КАК
	|		ОбработкаОбъектовЗапущена,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ДатаЗавершенияОбработкиОбъектов <> ДАТАВРЕМЯ(1, 1, 1) КАК
	|		ОбработкаОбъектовЗавершена,
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.ФактическаяДатаЗавершения КАК ФактическаяДатаЗавершения
	|ИЗ
	|	РегистрСведений.СостоянияВыгрузкиЗагрузкиОбластейДанных КАК СостоянияВыгрузкиЗагрузкиОбластейДанных
	|ГДЕ
	|	СостоянияВыгрузкиЗагрузкиОбластейДанных.Идентификатор = &Идентификатор";
	
	ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
	
	Если Не ЗначениеЗаполнено(ТаблицаРезультата) Тогда
		Возврат Неопределено;		
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаРезультата)[0];
	
КонецФункции

Функция ПредставлениеСостоянияВыгрузкиЗагрузкиОбластиДанных(СостояниеВыгрузкиЗагрузки, ЧасовойПояс = Неопределено) Экспорт
		
	Если Не СостояниеВыгрузкиЗагрузки.ОбработкаОбъектовЗапущена Тогда
		
		Возврат ВыгрузкаЗагрузкаДанныхКлиентСервер.ПредставлениеСостоянияПодготовкиВыгрузкиЗагрузкиОбластиДанных(
			СостояниеВыгрузкиЗагрузки.ЗагрузкаОбластиДанных);
				
	ИначеЕсли СостояниеВыгрузкиЗагрузки.ОбработкаОбъектовЗавершена Тогда
		
		Если СостояниеВыгрузкиЗагрузки.ЗагрузкаОбластиДанных Тогда
			ПредставлениеСостояния = НСтр("ru = 'Выполняется завершение загрузки данных.'");
		Иначе
			ПредставлениеСостояния = НСтр("ru = 'Выполняется завершение выгрузки данных.'");
		КонецЕсли;	
		
	Иначе
		
		ЧастиПредставленияСостояния = Новый Массив();
		
		Если СостояниеВыгрузкиЗагрузки.ЗагрузкаОбластиДанных Тогда
			ПерваяЧастьПредставленияСостояния = НСтр("ru = 'Выполняется загрузка данных.'");
		Иначе
			ПерваяЧастьПредставленияСостояния = НСтр("ru = 'Выполняется выгрузка данных.'");
		КонецЕсли;
		
		ЧастиПредставленияСостояния.Добавить(ПерваяЧастьПредставленияСостояния);		
		
		РасчетнаяДатаЗавершения = СостояниеВыгрузкиЗагрузки.РасчетнаяДатаЗавершения;
		Если ЗначениеЗаполнено(РасчетнаяДатаЗавершения) Тогда
			
			Если ЧасовойПояс = Неопределено Тогда 
				ЧасовойПояс = ЧасовойПоясСеанса();
			КонецЕсли;
			
			РасчетнаяДатаЗавершенияВМестномВремени = МестноеВремя(РасчетнаяДатаЗавершения, ЧасовойПояс);
			ТекущаяДатаВМестномВремени = МестноеВремя(ТекущаяУниверсальнаяДата(), ЧасовойПояс);
			
			Если НачалоДня(ТекущаяДатаВМестномВремени) = НачалоДня(РасчетнаяДатаЗавершенияВМестномВремени) Тогда
				ШаблонПредставленияДатыЗавершения = НСтр("ru = 'Расчетное время завершения %1.'");
				ФорматнаяСтрока = "ДФ='HH:mm';";
			Иначе
				ШаблонПредставленияДатыЗавершения = НСтр("ru = 'Расчетная дата завершения %1.'");
				ФорматнаяСтрока = "ДФ='dd MMMM HH:mm';";
			КонецЕсли;

			ВтораяЧастьПредставленияСостояния = СтрШаблон(
				ШаблонПредставленияДатыЗавершения,
				Формат(РасчетнаяДатаЗавершенияВМестномВремени, ФорматнаяСтрока));
			
			ЧастиПредставленияСостояния.Добавить(ВтораяЧастьПредставленияСостояния);			
		
		КонецЕсли;

		ПредставлениеСостояния = СтрСоединить(ЧастиПредставленияСостояния, " ");
		
	КонецЕсли;
		
	Возврат ПредставлениеСостояния;
	
КонецФункции

Функция ПроцентЗавершенияВыгрузкиЗагрузкиОбластиДанных(СостояниеВыгрузкиЗагрузкиОбластиДанных) Экспорт
		
	Если СостояниеВыгрузкиЗагрузкиОбластиДанных = Неопределено 
		Или Не СостояниеВыгрузкиЗагрузкиОбластиДанных.ОбработкаОбъектовЗапущена
		Или СостояниеВыгрузкиЗагрузкиОбластиДанных.ОбработкаОбъектовЗавершена Тогда	
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СостояниеВыгрузкиЗагрузкиОбластиДанных.ПроцентЗавершения;
			
КонецФункции

#КонецОбласти

#Область ОбработкаСсылокНаТипыИсключаемыеИзВыгрузки

// Дополняет массив типов исключаемых из выгрузки-загрузки
// Предназначен для использования в обработчиках ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки.
//
// Параметры:
// 	Типы - Массив из ФиксированнаяСтруктура
//	Тип - ОбъектМетаданных - объект метаданных исключаемый из выгрузки-загрузки
//	ДействиеСоСсылками - Строка -  вариант действия при обнаружении ссылки на объект исключаемый из выгрузки
//		Поддерживаются следующие действия:
//			ВыгрузкаЗагрузкаДанных.ДействиеСоСсылкамиНеИзменять() - не будет произведено никаких действий  
//			ВыгрузкаЗагрузкаДанных.ДействиеСоСсылкамиОчищать() - будет выполнено очищение ссылки на невыгружаемый объект  
//			ВыгрузкаЗагрузкаДанных.ДействиеСоСсылкамиНеВыгружатьОбъект() - объект содержащий ссылку не будет выгружен
//		  
// Пример использования:
//  Процедура ПриЗаполненииТиповИсключаемыхИзВыгрузкиЗагрузки(Типы) Экспорт
//		ВыгрузкаЗагрузкаДанных.ДополнитьТипомИсключаемымИзВыгрузкиЗагрузки(
//			Типы,
//			Метаданные.Справочники.СценарииПроверок,
//			ВыгрузкаЗагрузкаДанных.ДействиеСоСсылкамиНеВыгружатьОбъект());
//	КонецПроцедуры 
//
Процедура ДополнитьТипомИсключаемымИзВыгрузкиЗагрузки(Типы, Тип, ДействиеСоСсылками) Экспорт

	Если Не (ДействиеСоСсылками = ДействиеСоСсылкамиНеИзменять() 
		Или ДействиеСоСсылками = ДействиеСоСсылкамиОчищать() 
		Или ДействиеСоСсылками = ДействиеСоСсылкамиНеВыгружатьОбъект()) Тогда	
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'Обнаружено неподдерживаемое действие ''%1'' при обнаружении ссылки на тип ''%2'' исключаемый из выгрузки'"),
			ДействиеСоСсылками,
			Тип);	
					
	КонецЕсли;
	
	ОписаниеТипа = Новый Структура("Тип, Действие", Тип, ДействиеСоСсылками);
	
	Типы.Добавить(
		Новый ФиксированнаяСтруктура(ОписаниеТипа));
	
КонецПроцедуры
	
// Действие со ссылками - Не изменять.
