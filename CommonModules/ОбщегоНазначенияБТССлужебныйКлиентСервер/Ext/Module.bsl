
#Область СлужебныйПрограммныйИнтерфейс

// Получает значение заголовка независимо от регистра.
//
// Параметры: 
//  ЗапросОтвет - HTTPЗапрос, HTTPОтвет, HTTPСервисЗапрос, HTTPСервисОтвет - запрос или ответ.
//  Заголовок - Строка - имя заголовка.
//
// Возвращаемое значение:
//  Строка, Неопределено - значение заголовка.
//
Функция ЗаголовокHTTP(ЗапросОтвет, Знач Заголовок) Экспорт
	
	Заголовок = НРег(Заголовок);
	Для Каждого КлючИЗначение Из ЗапросОтвет.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = Заголовок Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает шаблон параметров логирования исходящего HTTP-запроса.
// 
// Возвращаемое значение:
//  Структура - Новый параметры логирования исходящего запроса:
// * ИмяСобытияЖР - Строка - ожидается имя события журнала регистрации (обязательно)
// * МетаданныеЖР - Неопределено, ОбъектМетаданных - ожидается метаданные, для записи в журнал регистрации (не обязательно)
//                                                  (по умолчанию Неопределено)
// * ДанныеЖР - Произвольный - ожидается данные, для записи в журнал регистрации (не обязательно) (по умолчанию Неопределено)
// * СоединениеHTTP - HTTPСоединение, Неопределено - ожидается объект HTTPСоединение для формирования описания
//                                                   события (обязательно) (по умолчанию Неопределено)
// * МетодHTTP - Строка - ожидается HTTP-метод - GET, POST, PUT, DELETE, ... (обязательно)
// * ЗапросHTTP - HTTPЗапрос, Неопределено - ожидается объект HTTPЗапрос для формирования описания события (обязательно)
//                                           (по умолчанию Неопределено)
// * ОтветHTTP - HTTPОтвет, Неопределено - ожидается объект HTTPОтвет для формирования описания события (не обязательно)
//                                         (по умолчанию Неопределено)
// * ЛогироватьТелоЗапроса - Булево - Истина, если нужно логировать тело запроса (по умолчанию Истина)
// * ОтправленыДвоичныеДанные - Булево - Истина, если в запросе отправлены двоичные данные (по умолчанию Ложь)
// * ПолученыДвоичныеДанные - Булево - Истина, если в ответе получены двоичные данные (по умолчанию Ложь)
// * ИнформацияОбОшибке - Строка - информация об ошибке (не обязательно)
// * ЭтоОшибка - Булево - Используется для определения уровня журнала регистрации (не обязательно),
//                        если Истина - уровень журнала регистрации "Ошибка,
//                        если Ложь - уровень журнала регистрации "Информация" (по умолчанию) 
//
Функция НовыйПараметрыЛогированияИсходящегоЗапроса() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяСобытияЖР","");
	Параметры.Вставить("МетаданныеЖР", Неопределено);
	Параметры.Вставить("ДанныеЖР", Неопределено);
	Параметры.Вставить("СоединениеHTTP", Неопределено);
	Параметры.Вставить("МетодHTTP", "");
	Параметры.Вставить("ЗапросHTTP", Неопределено);
	Параметры.Вставить("ОтветHTTP", Неопределено);
	Параметры.Вставить("ЛогироватьТелоЗапроса", Истина);
	Параметры.Вставить("ОтправленыДвоичныеДанные", Ложь);
	Параметры.Вставить("ПолученыДвоичныеДанные", Ложь);
	Параметры.Вставить("ИнформацияОбОшибке", "");
	Параметры.Вставить("ЭтоОшибка", Ложь);
	
	Возврат Параметры;
	
КонецФункции

// Записывает исходящий HTTP-запрос и ответ на него в журнал регистрации.
// 
// Параметры:
//  ПараметрыЛогирования - см. НовыйПараметрыЛогированияИсходящегоЗапроса
//
Процедура ЛогироватьИсходящийЗапрос(ПараметрыЛогирования) Экспорт
	
	#Если ВебКлиент Тогда
		ВызватьИсключение НСтр("ru = 'Логирование исходящего запроса недоступно в веб-клиенте.'");
	#КонецЕсли
	
	ЧастиОписания = Новый Массив;
	ЧастиОписания.Добавить(ОписаниеИсходящегоЗапроса(
		ПараметрыЛогирования.СоединениеHTTP, 
		ПараметрыЛогирования.МетодHTTP, 
		ПараметрыЛогирования.ЗапросHTTP,
		ПараметрыЛогирования.ЛогироватьТелоЗапроса,
		ПараметрыЛогирования.ОтправленыДвоичныеДанные));
	Если Не ПараметрыЛогирования.ОтветHTTP = Неопределено Тогда
		ЧастиОписания.Добавить("---");
		ЧастиОписания.Добавить(ОписаниеВходящегоОтвета(
			ПараметрыЛогирования.ОтветHTTP,
			ПараметрыЛогирования.ПолученыДвоичныеДанные));
	КонецЕсли;
	Если НЕ ПараметрыЛогирования.ИнформацияОбОшибке = "" Тогда
		ЧастиОписания.Добавить("---");
		ЧастиОписания.Добавить(НСтр("ru='Информация об ошибке:'"));
		ЧастиОписания.Добавить(ПараметрыЛогирования.ИнформацияОбОшибке);
	КонецЕсли;
	
	ПараметрыЗаписиЖурналаРегистрации = НовыйПараметрыЗаписиЖурналаРегистрации();
	ПараметрыЗаписиЖурналаРегистрации.ИмяСобытия = ПараметрыЛогирования.ИмяСобытияЖР;
	ПараметрыЗаписиЖурналаРегистрации.Ошибка = ПараметрыЛогирования.ЭтоОшибка;
	ПараметрыЗаписиЖурналаРегистрации.Метаданные = ПараметрыЛогирования.МетаданныеЖР;
	ПараметрыЗаписиЖурналаРегистрации.Данные = ПараметрыЛогирования.ДанныеЖР;
	ПараметрыЗаписиЖурналаРегистрации.Комментарий = СтрСоединить(ЧастиОписания, Символы.ПС);	
	
	ОбщегоНазначенияБТССлужебныйВызовСервера.ДобавитьЗаписьЖурналаРегистрации(ПараметрыЗаписиЖурналаРегистрации);
	
КонецПроцедуры

// Возвращает шаблон параметров записи журнала регистрации
// 
// Возвращаемое значение:
//  Структура - Новый параметры записи журнала регистрации:
// * ИмяСобытия - Строка - имя события журнала регистрации (обязательно)
// * Ошибка - Булево - Используется для определения уровня журнала регистрации (не обязательно),
//                     если Истина - уровень журнала регистрации "Ошибка,
//                     если Ложь - уровень журнала регистрации "Информация" (по умолчанию)
// * Метаданные - Неопределено, ОбъектМетаданных - метаданные, для записи в журнал регистрации (не обязательно)
//                                                  (по умолчанию Неопределено)
// * Данные - Произвольный - данные, для записи в журнал регистрации (не обязательно) (по умолчанию Неопределено)
// * Комментарий - Строка - комментарий для записи в журнал регистрации (не обязательно)
//
Функция НовыйПараметрыЗаписиЖурналаРегистрации() Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("ИмяСобытия","");
	Параметры.Вставить("Ошибка", Ложь);
	Параметры.Вставить("Метаданные", Неопределено);
	Параметры.Вставить("Данные", Неопределено);
	Параметры.Вставить("Комментарий", "");
	
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЛогированиеHTTPЗапросов

Функция ОписаниеИсходящегоЗапроса(Соединение, Метод, Запрос, ЛогироватьТелоЗапроса, ОтправленыДвоичныеДанные)
	
	СтрокиЗапроса = Новый Массив;
	СтрокиЗапроса.Добавить(СтрШаблон("%1 %2://%3/%4", Метод, ?(Соединение.ЗащищенноеСоединение = Неопределено, "http",
		"https"), Соединение.Сервер, Запрос.АдресРесурса));
	Если ЗначениеЗаполнено(Соединение.Пользователь) Тогда
		СтрокиЗапроса.Добавить(СтрШаблон("Authorization: Basic %1:***", Соединение.Пользователь));
	КонецЕсли;
	
	Для Каждого СтрокаЗаголовка Из Запрос.Заголовки Цикл
		ЗначениеЗаголовка = ?(НРег(СтрокаЗаголовка.Ключ) = НРег("Authorization"), "***", СтрокаЗаголовка.Значение);
		СтрокиЗапроса.Добавить(СтрокаЗаголовка.Ключ + ": " + ЗначениеЗаголовка);
	КонецЦикла;
	СтрокиЗапроса.Добавить("");
	
	Если ЛогироватьТелоЗапроса Тогда
		Если ОтправленыДвоичныеДанные Тогда
			ДвоичныеДанные = Запрос.ПолучитьТелоКакДвоичныеДанные();
			СтрокаДанных = ПолучитьBase64СтрокуИзДвоичныхДанных(ДвоичныеДанные);
		Иначе
			СтрокаДанных = Запрос.ПолучитьТелоКакСтроку();
		КонецЕсли;
		Если СтрДлина(СтрокаДанных) > 1500 Тогда
			СтрокаДанных = Лев(СтрокаДанных, 1500) + "...";
		КонецЕсли;
		СтрокиЗапроса.Добавить(СтрокаДанных);
	КонецЕсли;
	
	Возврат СтрСоединить(СтрокиЗапроса, Символы.ПС);
	
КонецФункции

Функция ОписаниеВходящегоОтвета(Ответ, ПолученыДвоичныеДанные)
	
	СтрокиОтвета = Новый Массив;
	СтрокиОтвета.Добавить(Ответ.КодСостояния);
	Для Каждого СтрокаЗаголовка Из Ответ.Заголовки Цикл
		СтрокиОтвета.Добавить(СтрокаЗаголовка.Ключ + ": " + СтрокаЗаголовка.Значение);
		Если СтрокаЗаголовка.Ключ = "Content-Disposition" Тогда
			ПоляЗаголовка = СтрРазделить(СтрокаЗаголовка.Значение, "; ", Ложь);
			ФайлДанных = СтрЗаменить(СтрЗаменить(ПоляЗаголовка[1], "filename=""", ""), """", "");
			ИмяРасширение = СтрРазделить(ФайлДанных, ".", Ложь);
			Если ТекстовыеТипыДанных().Найти(ИмяРасширение[1]) = Неопределено Тогда
				ПолученыДвоичныеДанные = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	СтрокиОтвета.Добавить("");
	
	Если ПолученыДвоичныеДанные Тогда
		ДвоичныеДанные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		СтрокаДанных = ПолучитьBase64СтрокуИзДвоичныхДанных(ДвоичныеДанные);
	Иначе
		СтрокаДанных = Ответ.ПолучитьТелоКакСтроку();
	КонецЕсли;
	Если СтрДлина(СтрокаДанных) > 1500 Тогда
		СтрокаДанных = Лев(СтрокаДанных, 1500) + "...";
	КонецЕсли;
	СтрокиОтвета.Добавить(СтрокаДанных);
	
	Возврат СтрСоединить(СтрокиОтвета, Символы.ПС);
	
КонецФункции

Функция ТекстовыеТипыДанных()

	Возврат СтрРазделить("txt;json", ";");

КонецФункции

#КонецОбласти

