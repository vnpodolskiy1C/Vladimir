// Возвращает имя пользовательского вида приложения
// 
// Возвращаемое значение:
//  Строка - имя текущего пользовательского вида текущего приложения
// 
Функция ИмяТекущегоПользовательскогоВидаПриложения() Экспорт
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	
	Если ОбщегоНазначения.РазделениеВключено()
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		Возврат ИмяТекущегоПользовательскогоВидаПриложенияОбластиДанных();
	КонецЕсли;
	
	ПараметрыВидаПриложения = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(
		ИдентификаторВидаПриложения(), КлючПараметрыВидаПриложения());
	Если ПараметрыВидаПриложения <> Неопределено Тогда
		Возврат ПараметрыВидаПриложения.ИмяПользовательское;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Определяет массив имен расширений видов приложений, которые будут исключены из выгрузки
