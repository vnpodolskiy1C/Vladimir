#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПользовательскоеСоглашение = "https://downloads.v8.1c.ru/content/UserAgreement/Payment-gateway.html";
	
	Элементы.ГруппаПодвал.Видимость = Параметры.КнопкаПродолжить;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПользовательскоеСоглашениеПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеСобытия) = Тип("ФиксированнаяСтруктура") И ДанныеСобытия.Href <> Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(
			ДанныеСобытия.Href);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПринятьСоглашение(Команда)
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить(
		"ПользовательскоеСоглашениеПринято",
		Истина);
	
	Закрыть(ПараметрыЗакрытия);
	
КонецПроцедуры

#КонецОбласти