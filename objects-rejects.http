### Пустой поиск типов
GET {{$dotenv OBJECTS_URL}}/types?q=
Authorization: {{$dotenv OBJECTS_AUTH}}

### Пробельный поиск типов
GET {{$dotenv OBJECTS_URL}}/types?q=%20
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск типов, больше 20
GET {{$dotenv OBJECTS_URL}}/types?q=а
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неизвестное имя справочника
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник.НетТакого
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неподдерживаемый вид
GET {{$dotenv OBJECTS_URL}}/type?name=РегистрСведений.КурсыВалют
Authorization: {{$dotenv OBJECTS_AUTH}}

### Имя без точки
GET {{$dotenv OBJECTS_URL}}/type?name=Партнеры
Authorization: {{$dotenv OBJECTS_AUTH}}

### Лишняя точка
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоПартнеры.Лишнее
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описание документа
GET {{$dotenv OBJECTS_URL}}/type?name=Документ._ДемоСчетНаОплатуПокупателю
Authorization: {{$dotenv OBJECTS_AUTH}}

### Описание подчиненного справочника
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоКонтактныеЛицаПартнеров
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неподдерживаемое поле файла
GET {{$dotenv OBJECTS_URL}}/type?name=Справочник._ДемоНоменклатураПрисоединенныеФайлы
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск без строки
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоПартнеры&q=
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск без типа
GET {{$dotenv OBJECTS_URL}}/search?type=&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск неизвестного вида
GET {{$dotenv OBJECTS_URL}}/search?type=РегистрСведений.КурсыВалют&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск неизвестного справочника
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник.НетТакого&q=Альфа
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск документа по номеру
GET {{$dotenv OBJECTS_URL}}/search?type=Документ._ДемоСчетНаОплатуПокупателю&q=0
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск номенклатуры длиннее страницы
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник._ДемоНоменклатура&q=а
Authorization: {{$dotenv OBJECTS_AUTH}}

### Поиск справочника без наименования
GET {{$dotenv OBJECTS_URL}}/search?type=Справочник.ХранилищеДвоичныхДанных&q=а
Authorization: {{$dotenv OBJECTS_AUTH}}

### Прочитать существующего партнера
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id={{$dotenv PARTNER_ID}}
Authorization: {{$dotenv OBJECTS_AUTH}}

### Некорректный UUID
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id=не-uuid
Authorization: {{$dotenv OBJECTS_AUTH}}

### UUID в верхнем регистре
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id=9203492B-EA3E-11DE-8634-001D600D9AD2
Authorization: {{$dotenv OBJECTS_AUTH}}

### Неизвестный UUID
GET {{$dotenv OBJECTS_URL}}/object?type=Справочник._ДемоПартнеры&id=00000000-0000-0000-0000-000000000000
Authorization: {{$dotenv OBJECTS_AUTH}}

### Чтение неподдерживаемого вида
GET {{$dotenv OBJECTS_URL}}/object?type=РегистрСведений.КурсыВалют&id=00000000-0000-0000-0000-000000000000
Authorization: {{$dotenv OBJECTS_AUTH}}

### Создание группы
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{
  "type": "Справочник._ДемоПартнеры",
  "header": {
    "Наименование": "Группа Ромашка",
    "ЭтоГруппа": true,
    "ВидПартнера": "ЮридическоеЛицо"
  },
  "tables": {}
}

### Подчиненный справочник без владельца
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{
  "type": "Справочник._ДемоКонтактныеЛицаПартнеров",
  "header": {
    "Наименование": "Иван"
  },
  "tables": {}
}

### Запись незаписываемого поля
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{
  "type": "Справочник._ДемоПартнеры",
  "header": {
    "Наименование": "Ромашка",
    "ВидПартнера": "ЮридическоеЛицо",
    "Ссылка": "00000000-0000-0000-0000-000000000000"
  },
  "tables": {}
}

### Запись дополнительных реквизитов БСП
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{
  "type": "Справочник._ДемоПартнеры",
  "header": {
    "Наименование": "Ромашка",
    "ВидПартнера": "ЮридическоеЛицо"
  },
  "tables": {
    "ДополнительныеРеквизиты": []
  }
}

### Битый JSON
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{ "type":

### Неподдерживаемый вид в теле
POST {{$dotenv OBJECTS_URL}}/object
Authorization: {{$dotenv OBJECTS_AUTH}}
Content-Type: application/json

{
  "type": "РегистрСведений.КурсыВалют",
  "header": {},
  "tables": {}
}
