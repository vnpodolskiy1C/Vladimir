Функция СоздатьОбъект(Запрос)
	ТранзакцияНачата = Ложь;
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Если Не ДопустимыйТипСодержимого(Запрос) Тогда
			Возврат ОтказJSON(415, "unsupported_media_type", "Требуется application/json с кодировкой UTF-8");
		КонецЕсли;
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			Данные = ПрочитатьJSON(Чтение, Истина);
			Хвост = Чтение.Прочитать();
			Чтение.Закрыть();
			Если Хвост Тогда
				Возврат ОтказJSON(400, "invalid_json", "После JSON не допускается хвост");
			КонецЕсли;
		Исключение
			Возврат ОтказJSON(400, "invalid_json", "Некорректный JSON");
		КонецПопытки;
		Ошибки = Новый Массив;
		ПроверитьКореньСоздания(Данные, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(400, "invalid_data", "Некорректная структура запроса", Ошибки);
		КонецЕсли;
		ТипОбъекта = СчетаМагазинаМетаданные.РазрешитьТип(Данные.Получить("type"));
		Если ТипОбъекта = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_type", "Неизвестное полное имя типа", "type");
		КонецЕсли;
		Если ТипОбъекта.kind = "unsupported" Тогда
			Возврат ОтказJSON(422, "unsupported_type", "Поддерживаются только справочники и документы", "type");
		КонецЕсли;
		Если Не ПравоДоступа("Добавление", ТипОбъекта.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права добавления типа", "type");
		КонецЕсли;
		Схема = СчетаМагазинаМетаданные.Схема(ТипОбъекта);
		Если Не Схема.operations.create.allowed Тогда
			Возврат ОтказJSON(422, "unsupported_operation", Схема.operations.create.reason, "type");
		КонецЕсли;
		Подготовленные = СчетаМагазинаДанные.Подготовить(Данные, ТипОбъекта, Схема, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(400, "invalid_data", "Недопустимые поля или значения", Ошибки);
		КонецЕсли;
		НачатьТранзакцию();
		ТранзакцияНачата = Истина;
		Объект = СчетаМагазинаДанные.Создать(ТипОбъекта);
		СчетаМагазинаДанные.Заполнить(Объект, Подготовленные);
		ПолучитьСообщенияПользователю(Истина);
		ЗаполнениеКорректно = Объект.ПроверитьЗаполнение();
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Если Не ЗаполнениеКорректно Тогда
			ОтменитьТранзакцию();
			ТранзакцияНачата = Ложь;
			Возврат ОтказПроверки(Сообщения, Схема);
		КонецЕсли;
		Если ТипОбъекта.kind = "document" Тогда
			Объект.Записать(РежимЗаписиДокумента.Запись);
		Иначе
			Объект.Записать();
		КонецЕсли;
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Сохраненный = Неопределено;
		Если Не Объект.ЭтоНовый() И ЗначениеЗаполнено(Объект.Ссылка) Тогда
			Сохраненный = Объект.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		Если Сохраненный = Неопределено Тогда
			ОтменитьТранзакцию();
			ТранзакцияНачата = Ложь;
			Возврат ОтказПроверки(Сообщения, Схема);
		КонецЕсли;
		Если ТипОбъекта.kind = "document" И Сохраненный.Проведен
			Или СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта) И Сохраненный.ЭтоГруппа Тогда
			ВызватьИсключение "Нарушены инварианты создания объекта";
		КонецЕсли;
		// Краткий ответ и JSON полностью готовы до фиксации.
		Ответ = ОтветJSON(201, СчетаМагазинаДанные.Кратко(ТипОбъекта, Сохраненный));
		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;
		Возврат Ответ;
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат НепредвиденнаяОшибка(Информация);
	КонецПопытки;
КонецФункции

Функция ДопустимыйТипСодержимого(Запрос)
	Для Каждого Заголовок Из Запрос.Заголовки Цикл
		Если НРег(Заголовок.Ключ) <> "content-type" Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(НРег(Заголовок.Значение), ";", Истина);
		Если Части.Количество() < 1 Или Части.Количество() > 2 Или СокрЛП(Части[0]) <> "application/json" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Части.Количество() = 1 Тогда
			Возврат Истина;
		КонецЕсли;
		Параметр = СтрРазделить(Части[1], "=", Истина);
		Возврат Параметр.Количество() = 2 И СокрЛП(Параметр[0]) = "charset"
			И (СокрЛП(Параметр[1]) = "utf-8" Или СокрЛП(Параметр[1]) = """utf-8""");
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура ПроверитьКореньСоздания(Данные, Ошибки)
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Корень должен быть объектом JSON");
		Возврат;
	КонецЕсли;
	Допустимые = СтрРазделить("type,header,tables", ",");
	Для Каждого Пара Из Данные Цикл
		Если Допустимые.Найти(Пара.Ключ) = Неопределено Тогда
			СчетаМагазинаДанные.Ошибка(Ошибки, Пара.Ключ, "Неизвестное поле корня");
		КонецЕсли;
	КонецЦикла;
	Для Каждого Имя Из Допустимые Цикл
		ОжидаемыйТип = ?(Имя = "type", Тип("Строка"), Тип("Соответствие"));
		Если Не СчетаМагазинаЗначения.ЕстьКлюч(Данные, Имя) Или ТипЗнч(Данные.Получить(Имя)) <> ОжидаемыйТип Тогда
			СчетаМагазинаДанные.Ошибка(Ошибки, Имя, "Отсутствует обязательное поле или неверный тип JSON");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОтказПроверки(Сообщения, Схема)
	Ошибки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		СчетаМагазинаДанные.Ошибка(Ошибки, ПутьСообщения(Сообщение.Поле, Схема), Сообщение.Текст);
	КонецЦикла;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка или обработчик записи отказал без сообщения");
	КонецЕсли;
	Возврат ОшибкаJSON(422, "validation_failed", "Объект не прошел штатную проверку или запись", Ошибки);
КонецФункции

Функция ПутьСообщения(Поле, Схема)
	// Сопоставляем структурный идентификатор поля; текст сообщения не разбирается.
	Если ТипЗнч(Поле) <> Тип("Строка") Или ПустаяСтрока(Поле) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СчетаМагазинаМетаданные.НайтиОписание(Схема.fields, Поле) <> Неопределено Тогда
		Возврат "header." + Поле;
	КонецЕсли;
	Для Каждого Таблица Из Схема.tables Цикл
		Префикс = Таблица.name + "[";
		Если Лев(Поле, СтрДлина(Префикс)) <> Префикс Тогда
			Продолжить;
		КонецЕсли;
		КонецИндекса = СтрНайти(Поле, "].");
		Если КонецИндекса = 0 Тогда
			Продолжить;
		КонецЕсли;
		Индекс = Сред(Поле, СтрДлина(Префикс) + 1, КонецИндекса - СтрДлина(Префикс) - 1);
		Имя = Сред(Поле, КонецИндекса + 2);
		Если Цифры(Индекс) И СчетаМагазинаМетаданные.НайтиОписание(Таблица.fields, Имя) <> Неопределено Тогда
			Возврат "tables." + Поле;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиТипы(Запрос)
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "q,limit");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Параметры = ПараметрыПоиска(Запрос);
		Если Параметры.error <> Неопределено Тогда
			Возврат Параметры.error;
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.НайтиТипы(Параметры.q, Параметры.limit));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ОписатьТип(Запрос)
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "name");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Имя = Запрос.ПараметрыЗапроса.Получить("name");
		Если Имя = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_parameter", "Требуется полное имя типа", "name");
		КонецЕсли;
		ТипОбъекта = СчетаМагазинаМетаданные.РазрешитьТип(Имя);
		Если ТипОбъекта = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_type", "Неизвестное или некорректное полное имя типа", "name");
		КонецЕсли;
		Если ТипОбъекта.kind = "unsupported" Тогда
			Возврат ОтказJSON(422, "unsupported_type", "Поддерживаются только справочники и документы", "name");
		КонецЕсли;
		Если Не ПравоДоступа("Чтение", ТипОбъекта.metadata) И Не ПравоДоступа("Добавление", ТипОбъекта.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права чтения или добавления типа", "name");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.Схема(ТипОбъекта));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция НайтиОбъекты(Запрос)
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "type,q,limit");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Параметры = ПараметрыПоиска(Запрос);
		Если Параметры.error <> Неопределено Тогда
			Возврат Параметры.error;
		КонецЕсли;
		Разрешение = ТипОбъектов(Запрос);
		Если Разрешение.error <> Неопределено Тогда
			Возврат Разрешение.error;
		КонецЕсли;
		ТипОбъекта = Разрешение.value;
		Если Не ПравоДоступа("Чтение", ТипОбъекта.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права чтения типа", "type");
		КонецЕсли;
		Операция = СчетаМагазинаМетаданные.Операции(ТипОбъекта).search;
		Если Не Операция.allowed Тогда
			Возврат ОтказJSON(422, "unsupported_operation", Операция.reason, "type");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаДанные.НайтиОбъекты(ТипОбъекта, Параметры.q, Параметры.limit));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПрочитатьОбъект(Запрос)
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "type,id");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Разрешение = ТипОбъектов(Запрос);
		Если Разрешение.error <> Неопределено Тогда
			Возврат Разрешение.error;
		КонецЕсли;
		Идентификатор = Запрос.ПараметрыЗапроса.Получить("id");
		Если Идентификатор = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_parameter", "Требуется идентификатор объекта", "id");
		КонецЕсли;
		Идентификатор = СчетаМагазинаЗначения.УникальныйИдентификаторИзСтроки(Идентификатор);
		Если Идентификатор = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_id", "Идентификатор должен быть UUID с дефисами", "id");
		КонецЕсли;
		ТипОбъекта = Разрешение.value;
		Если Не ПравоДоступа("Чтение", ТипОбъекта.metadata) Тогда
			Возврат ОбъектНеНайден();
		КонецЕсли;
		Ошибки = Новый Массив;
		Данные = СчетаМагазинаДанные.Прочитать(ТипОбъекта, СчетаМагазинаМетаданные.Схема(ТипОбъекта), Идентификатор, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(422, "unsupported_value", "Невозможно полное чтение объекта", Ошибки);
		КонецЕсли;
		Если Данные = Неопределено Тогда
			Возврат ОбъектНеНайден();
		КонецЕсли;
		Возврат ОтветJSON(200, Данные);
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ЭтоНарушениеПрав(Информация) Тогда
			Возврат ОбъектНеНайден();
		КонецЕсли;
		Возврат НепредвиденнаяОшибка(Информация);
	КонецПопытки;
КонецФункции

Функция ОписатьРегистр(Запрос)
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "name");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Разрешение = РегистрИзПараметра(Запрос.ПараметрыЗапроса.Получить("name"));
		Если Разрешение.error <> Неопределено Тогда
			Возврат Разрешение.error;
		КонецЕсли;
		Регистр = Разрешение.value;
		Если Не ПравоДоступа("Чтение", Регистр.metadata) И Не ПравоДоступа("Изменение", Регистр.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права чтения или изменения регистра", "name");
		КонецЕсли;
		Возврат ОтветJSON(200, СчетаМагазинаМетаданные.ОписаниеРегистра(Регистр));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПолучитьСрезРегистра(Запрос)
	Попытка
		Разрешение = РегистрИзПараметра(Запрос.ПараметрыЗапроса.Получить("name"));
		Если Разрешение.error <> Неопределено Тогда
			Возврат Разрешение.error;
		КонецЕсли;
		Регистр = Разрешение.value;
		Если Не ПравоДоступа("Чтение", Регистр.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права чтения регистра", "name");
		КонецЕсли;
		Описание = СчетаМагазинаМетаданные.ОписаниеРегистра(Регистр);
		Операция = Описание.operations.slice;
		Если Не Операция.allowed Тогда
			Возврат ОтказJSON(422, "unsupported_operation", Операция.reason, "name");
		КонецЕсли;
		Параметры = ПараметрыРегистра(Запрос, Регистр, Описание, Истина);
		Если Параметры.error <> Неопределено Тогда
			Возврат Параметры.error;
		КонецЕсли;
		Момент = Параметры.date;
		Если Момент = Неопределено Тогда
			Момент = ТекущаяДатаСеанса();
		КонецЕсли;
		Ошибки = Новый Массив;
		Записи = СчетаМагазинаДанные.ЗаписиРегистра(Регистр, Описание, Момент, Параметры.filter, Истина, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(422, "unsupported_value", "Невозможно полное чтение записей регистра", Ошибки);
		КонецЕсли;
		Возврат ОтветJSON(200, Новый Структура("name,date,items,hasMore", Регистр.name,
			Формат(Момент, "ДФ=yyyy-MM-ddTHH:mm:ss"), Записи.items, Записи.hasMore));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ПолучитьИсториюРегистра(Запрос)
	Попытка
		Разрешение = РегистрИзПараметра(Запрос.ПараметрыЗапроса.Получить("name"));
		Если Разрешение.error <> Неопределено Тогда
			Возврат Разрешение.error;
		КонецЕсли;
		Регистр = Разрешение.value;
		Если Не ПравоДоступа("Чтение", Регистр.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права чтения регистра", "name");
		КонецЕсли;
		Описание = СчетаМагазинаМетаданные.ОписаниеРегистра(Регистр);
		Операция = Описание.operations.history;
		Если Не Операция.allowed Тогда
			Возврат ОтказJSON(422, "unsupported_operation", Операция.reason, "name");
		КонецЕсли;
		Параметры = ПараметрыРегистра(Запрос, Регистр, Описание, Ложь);
		Если Параметры.error <> Неопределено Тогда
			Возврат Параметры.error;
		КонецЕсли;
		Ошибки = Новый Массив;
		Записи = СчетаМагазинаДанные.ЗаписиРегистра(Регистр, Описание, Неопределено, Параметры.filter, Ложь, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(422, "unsupported_value", "Невозможно полное чтение записей регистра", Ошибки);
		КонецЕсли;
		Возврат ОтветJSON(200, Новый Структура("name,items,hasMore", Регистр.name, Записи.items, Записи.hasMore));
	Исключение
		Возврат НепредвиденнаяОшибка(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

Функция ЗаписатьЗначениеРегистра(Запрос)
	ТранзакцияНачата = Ложь;
	Попытка
		ОшибкаПараметра = ПроверитьПараметры(Запрос, "");
		Если ОшибкаПараметра <> Неопределено Тогда
			Возврат ОшибкаПараметра;
		КонецЕсли;
		Если Не ДопустимыйТипСодержимого(Запрос) Тогда
			Возврат ОтказJSON(415, "unsupported_media_type", "Требуется application/json с кодировкой UTF-8");
		КонецЕсли;
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			Данные = ПрочитатьJSON(Чтение, Истина);
			Хвост = Чтение.Прочитать();
			Чтение.Закрыть();
			Если Хвост Тогда
				Возврат ОтказJSON(400, "invalid_json", "После JSON не допускается хвост");
			КонецЕсли;
		Исключение
			Возврат ОтказJSON(400, "invalid_json", "Некорректный JSON");
		КонецПопытки;
		Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
			Возврат ОтказJSON(400, "invalid_data", "Корень должен быть объектом JSON");
		КонецЕсли;
		Если Не СчетаМагазинаЗначения.ЕстьКлюч(Данные, "name") Или ТипЗнч(Данные.Получить("name")) <> Тип("Строка") Тогда
			Возврат ОтказJSON(400, "invalid_data", "Отсутствует обязательное поле или неверный тип JSON", "name");
		КонецЕсли;
		Регистр = СчетаМагазинаМетаданные.РазрешитьРегистр(Данные.Получить("name"));
		Если Регистр = Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_type", "Неизвестное или некорректное полное имя типа", "name");
		КонецЕсли;
		Если Регистр.kind <> "register" Или Не Регистр.independent Тогда
			Текст = "Поддерживаются только независимые регистры сведений";
			Если Регистр.kind = "register" Тогда
				Текст = "Регистр сведений подчинён регистратору: поддерживаются только независимые регистры сведений";
			КонецЕсли;
			Возврат ОтказJSON(422, "unsupported_type", Текст, "name");
		КонецЕсли;
		Если Не ПравоДоступа("Изменение", Регистр.metadata) Тогда
			Возврат ОтказJSON(403, "forbidden", "Нет права изменения регистра", "name");
		КонецЕсли;
		Описание = СчетаМагазинаМетаданные.ОписаниеРегистра(Регистр);
		Если Не Описание.operations.record.allowed Тогда
			Возврат ОтказJSON(422, "unsupported_operation", Описание.operations.record.reason, "name");
		КонецЕсли;
		Ошибки = Новый Массив;
		Подготовленные = СчетаМагазинаДанные.ПодготовитьЗаписьРегистра(Данные, Регистр, Описание, Ошибки);
		Если Ошибки.Количество() > 0 Тогда
			Возврат ОшибкаJSON(400, "invalid_data", "Недопустимые поля или значения", Ошибки);
		КонецЕсли;
		НачатьТранзакцию();
		ТранзакцияНачата = Истина;
		ЗаписьНабора = СчетаМагазинаДанные.НаборЗаписиРегистра(Регистр, Подготовленные);
		ПолучитьСообщенияПользователю(Истина);
		ЗаполнениеКорректно = ЗаписьНабора.set.ПроверитьЗаполнение();
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Если Не ЗаполнениеКорректно Тогда
			ОтменитьТранзакцию();
			ТранзакцияНачата = Ложь;
			Возврат ОтказЗаписиРегистра(Сообщения, Описание);
		КонецЕсли;
		Попытка
			ЗаписьНабора.set.Записать(Истина);
		Исключение
			Сообщения = ПолучитьСообщенияПользователю(Истина);
			Если Сообщения.Количество() > 0 Тогда
				ОтменитьТранзакцию();
				ТранзакцияНачата = Ложь;
				Возврат ОтказЗаписиРегистра(Сообщения, Описание);
			КонецЕсли;
			ВызватьИсключение;
		КонецПопытки;
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		ОшибкиЧтения = Новый Массив;
		Записи = СчетаМагазинаДанные.ЗаписиРегистра(Регистр, Описание, Неопределено, Подготовленные.dimensions, Ложь, ОшибкиЧтения, Подготовленные.period);
		Если ОшибкиЧтения.Количество() > 0 Или Записи.items.Количество() = 0 Тогда
			ОтменитьТранзакцию();
			ТранзакцияНачата = Ложь;
			Если ОшибкиЧтения.Количество() > 0 Тогда
				Возврат ОшибкаJSON(422, "unsupported_value", "Невозможно полное чтение записей регистра", ОшибкиЧтения);
			КонецЕсли;
			Возврат ОтказЗаписиРегистра(Сообщения, Описание);
		КонецЕсли;
		Элемент = Записи.items[0];
		Ответ = ОтветJSON(200, Новый Структура("name,period,dimensions,resources,attributes,replaced", Регистр.name,
			Элемент.period, Элемент.dimensions, Элемент.resources, Элемент.attributes, ЗаписьНабора.replaced));
		ЗафиксироватьТранзакцию();
		ТранзакцияНачата = Ложь;
		Возврат Ответ;
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ТранзакцияНачата Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат НепредвиденнаяОшибка(Информация);
	КонецПопытки;
КонецФункции

Функция ОтказЗаписиРегистра(Сообщения, Описание)
	Ошибки = Новый Массив;
	Для Каждого Сообщение Из Сообщения Цикл
		СчетаМагазинаДанные.Ошибка(Ошибки, ПутьСообщенияРегистра(Сообщение.Поле, Описание), Сообщение.Текст);
	КонецЦикла;
	Если Ошибки.Количество() = 0 Тогда
		СчетаМагазинаДанные.Ошибка(Ошибки, Неопределено, "Штатная проверка или обработчик записи отказал без сообщения");
	КонецЕсли;
	Возврат ОшибкаJSON(422, "validation_failed", "Запись регистра не прошла штатную проверку или запись", Ошибки);
КонецФункции

Функция ПутьСообщенияРегистра(Поле, Описание)
	Если ТипЗнч(Поле) <> Тип("Строка") Или ПустаяСтрока(Поле) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = Поле;
	КонецИндекса = СтрНайти(Поле, "].");
	Если КонецИндекса > 0 Тогда
		Имя = Сред(Поле, КонецИндекса + 2);
	КонецЕсли;
	Если Имя = "Период" Тогда
		Возврат "period";
	ИначеЕсли СчетаМагазинаМетаданные.НайтиОписание(Описание.dimensions, Имя) <> Неопределено Тогда
		Возврат "dimensions." + Имя;
	ИначеЕсли СчетаМагазинаМетаданные.НайтиОписание(Описание.resources, Имя) <> Неопределено Тогда
		Возврат "resources." + Имя;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОбъектНеНайден()
	Возврат ОтказJSON(404, "not_found", "Объект не найден или недоступен", "id");
КонецФункции

Функция ПараметрыРегистра(Запрос, Регистр, Описание, СДатой)
	Результат = Новый Структура("date,filter,error", Неопределено, Новый Соответствие, Неопределено);
	Допустимые = "name";
	Имена = СчетаМагазинаМетаданные.ИменаИзмерений(Регистр);
	Если СДатой Тогда
		Допустимые = Допустимые + ",date";
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Допустимые = Допустимые + "," + Имя;
	КонецЦикла;
	ОшибкаПараметра = ПроверитьПараметры(Запрос, Допустимые);
	Если ОшибкаПараметра <> Неопределено Тогда
		Результат.error = ОшибкаПараметра;
		Возврат Результат;
	КонецЕсли;
	Если СДатой Тогда
		ТекстДаты = Запрос.ПараметрыЗапроса.Получить("date");
		Если ТекстДаты <> Неопределено Тогда
			Момент = СчетаМагазинаЗначения.МоментСреза(ТекстДаты);
			Если Момент = Неопределено Тогда
				Результат.error = ОтказJSON(400, "invalid_parameter", "Неверная дата среза: требуется YYYY-MM-DD или YYYY-MM-DDTHH:mm:ss", "date");
				Возврат Результат;
			КонецЕсли;
			Результат.date = Момент;
		КонецЕсли;
	КонецЕсли;
	Ошибки = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Текст = Запрос.ПараметрыЗапроса.Получить(Имя);
		Если Текст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поле = СчетаМагазинаМетаданные.НайтиОписание(Описание.dimensions, Имя);
		МетаПоля = Регистр.metadata.Измерения.Найти(Имя);
		БылоОшибок = Ошибки.Количество();
		Значение = СчетаМагазинаЗначения.ЗначениеОтбораИзСтроки(Текст, Поле, МетаПоля.Тип, Имя, Ошибки);
		Если Ошибки.Количество() = БылоОшибок Тогда
			Результат.filter.Вставить(Имя, Значение);
		КонецЕсли;
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Результат.error = ОшибкаJSON(400, "invalid_parameter", "Неверное значение отбора", Ошибки);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РегистрИзПараметра(Имя)
	Результат = Новый Структура("value,error", Неопределено, Неопределено);
	Если Имя = Неопределено Тогда
		Результат.error = ОтказJSON(400, "invalid_parameter", "Требуется полное имя регистра", "name");
		Возврат Результат;
	КонецЕсли;
	Регистр = СчетаМагазинаМетаданные.РазрешитьРегистр(Имя);
	Если Регистр = Неопределено Тогда
		Результат.error = ОтказJSON(400, "invalid_type", "Неизвестное или некорректное полное имя типа", "name");
		Возврат Результат;
	КонецЕсли;
	Если Регистр.kind <> "register" Или Не Регистр.independent Тогда
		Текст = "Поддерживаются только независимые регистры сведений";
		Если Регистр.kind = "register" Тогда
			Текст = "Регистр сведений подчинён регистратору: поддерживаются только независимые регистры сведений";
		КонецЕсли;
		Результат.error = ОтказJSON(422, "unsupported_type", Текст, "name");
		Возврат Результат;
	КонецЕсли;
	Результат.value = Регистр;
	Возврат Результат;
КонецФункции

Функция ТипОбъектов(Запрос)
	Результат = Новый Структура("value,error", Неопределено, Неопределено);
	Имя = Запрос.ПараметрыЗапроса.Получить("type");
	Если Имя = Неопределено Тогда
		Результат.error = ОтказJSON(400, "invalid_parameter", "Требуется полное имя типа", "type");
		Возврат Результат;
	КонецЕсли;
	Результат.value = СчетаМагазинаМетаданные.РазрешитьТип(Имя);
	Если Результат.value = Неопределено Тогда
		Результат.error = ОтказJSON(400, "invalid_type", "Неизвестное или некорректное полное имя типа", "type");
	ИначеЕсли Результат.value.kind = "unsupported" Тогда
		Результат.error = ОтказJSON(422, "unsupported_type", "Поддерживаются только справочники и документы", "type");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПараметрыПоиска(Запрос)
	Результат = Новый Структура("q,limit,error", Неопределено, 20, Неопределено);
	Поиск = Запрос.ПараметрыЗапроса.Получить("q");
	Если Поиск = Неопределено Или ПустаяСтрока(СокрЛП(Поиск)) Тогда
		Результат.error = ОтказJSON(400, "invalid_parameter", "Требуется непустая строка поиска", "q");
		Возврат Результат;
	КонецЕсли;
	Результат.q = СокрЛП(Поиск);
	ПараметрЛимита = Запрос.ПараметрыЗапроса.Получить("limit");
	Если ПараметрЛимита <> Неопределено Тогда
		Если Не Цифры(ПараметрЛимита) Или СтрДлина(ПараметрЛимита) > 3 Тогда
			Результат.error = ОтказJSON(400, "invalid_parameter", "Лимит должен быть целым числом от 1 до 100", "limit");
			Возврат Результат;
		КонецЕсли;
		Результат.limit = Число(ПараметрЛимита);
		Если Результат.limit < 1 Или Результат.limit > 100 Тогда
			Результат.error = ОтказJSON(400, "invalid_parameter", "Лимит должен быть целым числом от 1 до 100", "limit");
		КонецЕсли;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПроверитьПараметры(Запрос, ДопустимыеИмена)
	Допустимые = СтрРазделить(ДопустимыеИмена, ",");
	Встреченные = Новый Соответствие;
	Для Каждого Параметр Из Запрос.ПараметрыЗапроса Цикл
		Если ПустаяСтрока(ДопустимыеИмена) Или Допустимые.Найти(Параметр.Ключ) = Неопределено
			Или Встреченные.Получить(Параметр.Ключ) <> Неопределено Тогда
			Возврат ОтказJSON(400, "invalid_parameter", "Неизвестный или повторяющийся параметр запроса", Параметр.Ключ);
		КонецЕсли;
		Встреченные.Вставить(Параметр.Ключ, Истина);
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Цифры(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ОтветJSON(Статус, Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

Функция ОшибкаJSON(Статус, Код, Текст, Подробности)
	Возврат ОтветJSON(Статус, Новый Структура("error", Новый Структура("code,message,details", Код, Текст, Подробности)));
КонецФункции

Функция ОтказJSON(Статус, Код, Текст, Путь = Неопределено)
	Подробности = Новый Массив;
	СчетаМагазинаДанные.Ошибка(Подробности, Путь, Текст);
	Возврат ОшибкаJSON(Статус, Код, Текст, Подробности);
КонецФункции

Функция ЭтоНарушениеПрав(Информация)
	Возврат Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь);
КонецФункции

Функция НепредвиденнаяОшибка(Информация)
	Если ЭтоНарушениеПрав(Информация) Тогда
		Возврат ОтказJSON(403, "forbidden", "Недостаточно прав на операцию");
	КонецЕсли;
	ЗаписьЖурналаРегистрации("СчетаМагазина", УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(Информация));
	Возврат ОтказJSON(500, "internal_error", "Внутренняя ошибка сервиса");
КонецФункции
