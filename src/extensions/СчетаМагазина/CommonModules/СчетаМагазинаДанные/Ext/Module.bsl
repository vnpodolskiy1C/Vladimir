Процедура Ошибка(Ошибки, Путь, Сообщение) Экспорт
	СчетаМагазинаЗначения.Ошибка(Ошибки, Путь, Сообщение);
КонецПроцедуры

Функция НайтиОбъекты(ТипОбъекта, СтрокаПоиска, Лимит) Экспорт
	Мета = ТипОбъекта.metadata;
	Если ТипОбъекта.kind = "catalog" Тогда
		ПолеПоиска = "Объекты.Наименование";
		Код = ?(Мета.ДлинаКода > 0, "Объекты.Код", """""");
		Группа = ?(СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта), "Объекты.ЭтоГруппа", "ЛОЖЬ");
		ОсобыеПоля = Код + " КАК Код, " + Группа + " КАК ЭтоГруппа";
	Иначе
		ПолеПоиска = "Объекты.Номер";
		Если СчетаМагазинаМетаданные.Реквизит(Мета, "Номер").Тип.СодержитТип(Тип("Число")) Тогда
			ПолеПоиска = "ВЫРАЗИТЬ(Объекты.Номер КАК СТРОКА(" + Формат(Мета.ДлинаНомера, "ЧГ=0") + "))";
		КонецЕсли;
		ОсобыеПоля = "Объекты.Номер КАК Номер, Объекты.Дата КАК Дата, Объекты.Проведен КАК Проведен";
	КонецЕсли;
	// В текст попадают только метаданные проверенного типа и проверенный числовой лимит.
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + "
		| Объекты.Ссылка КАК Ссылка, ПРЕДСТАВЛЕНИЕ(Объекты.Ссылка) КАК Представление, " + ОсобыеПоля + "
		| ИЗ " + Мета.ПолноеИмя() + " КАК Объекты
		| ГДЕ НЕ Объекты.ПометкаУдаления
		| И " + ПолеПоиска + " ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		| УПОРЯДОЧИТЬ ПО Объекты." + ?(ТипОбъекта.kind = "catalog", "Наименование", "Номер") + ", Объекты.Ссылка";
	Шаблон = СокрЛП(СтрокаПоиска);
	Шаблон = СтрЗаменить(Шаблон, "~", "~~");
	Для Каждого Символ Из СтрРазделить("%,_,[,],^", ",") Цикл
		Шаблон = СтрЗаменить(Шаблон, Символ, "~" + Символ);
	КонецЦикла;
	Запрос.УстановитьПараметр("Шаблон", "%" + Шаблон + "%");
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Если ТипОбъекта.kind = "catalog" Тогда
			Элемент = КраткоИзПолей(ТипОбъекта, Выборка.Ссылка, Выборка.Представление, Выборка.Код, Выборка.ЭтоГруппа);
		Иначе
			Элемент = КраткоИзПолей(ТипОбъекта, Выборка.Ссылка, Выборка.Представление,,, Выборка.Номер, Выборка.Дата, Выборка.Проведен);
		КонецЕсли;
		Элементы.Добавить(Элемент);
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция Прочитать(ТипОбъекта, Схема, Идентификатор, Ошибки) Экспорт
	Мета = ТипОбъекта.metadata;
	Менеджер = ?(ТипОбъекта.kind = "catalog", Справочники[Мета.Имя], Документы[Мета.Имя]);
	Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);
	// Создание ссылки не доказывает существование. Запрос также применяет RLS.
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + Мета.ПолноеИмя() + " ГДЕ Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Контекст = ?(ТипОбъекта.kind = "document", "document", "item");
	Если СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта) И Объект.ЭтоГруппа Тогда
		Контекст = "folder";
	КонецЕсли;
	Шапка = Новый Соответствие;
	Для Каждого Поле Из Схема.fields Цикл
		Если Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		МетаПоля = СчетаМагазинаМетаданные.Реквизит(Мета, Поле.name);
		Шапка.Вставить(Поле.name, СчетаМагазинаЗначения.ВJSON(Объект[Поле.name], Поле, МетаПоля.Тип, "header." + Поле.name, Ошибки));
	КонецЦикла;
	Таблицы = Новый Соответствие;
	Для Каждого Таблица Из Схема.tables Цикл
		Если Таблица.appliesTo.Найти(Контекст) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		МетаТаблицы = Мета.ТабличныеЧасти[Таблица.name];
		Для Каждого СтрокаОбъекта Из Объект[Таблица.name] Цикл
			СтрокаJSON = Новый Соответствие;
			Путь = "tables." + Таблица.name + "[" + Формат(Строки.Количество(), "ЧГ=0; ЧН=0") + "].";
			Для Каждого Поле Из Таблица.fields Цикл
				Если Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МетаПоля = СчетаМагазинаМетаданные.Реквизит(МетаТаблицы, Поле.name);
				СтрокаJSON.Вставить(Поле.name, СчетаМагазинаЗначения.ВJSON(СтрокаОбъекта[Поле.name], Поле, МетаПоля.Тип, Путь + Поле.name, Ошибки));
			КонецЦикла;
			Строки.Добавить(СтрокаJSON);
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Если Ошибки.Количество() > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Кратко(ТипОбъекта, Объект);
	Результат.Вставить("header", Шапка);
	Результат.Вставить("tables", Таблицы);
	Возврат Результат;
КонецФункции

Функция Кратко(ТипОбъекта, Объект) Экспорт
	Если ТипОбъекта.kind = "catalog" Тогда
		Код = ?(ТипОбъекта.metadata.ДлинаКода > 0, Объект.Код, "");
		Группа = СчетаМагазинаМетаданные.ЕстьГруппы(ТипОбъекта) И Объект.ЭтоГруппа;
		Возврат КраткоИзПолей(ТипОбъекта, Объект.Ссылка, Строка(Объект.Ссылка), Код, Группа);
	КонецЕсли;
	Номер = ?(ТипОбъекта.metadata.ДлинаНомера > 0, Объект.Номер, "");
	Возврат КраткоИзПолей(ТипОбъекта, Объект.Ссылка, Строка(Объект.Ссылка),,, Номер, Объект.Дата, Объект.Проведен);
КонецФункции

Функция КраткоИзПолей(ТипОбъекта, Ссылка, Представление, Код = "", Группа = Ложь, Номер = "", ДатаОбъекта = Неопределено, Проведен = Ложь)
	Результат = Новый Структура("type,id,name", ТипОбъекта.name, НРег(Строка(Ссылка.УникальныйИдентификатор())), Представление);
	Если ТипОбъекта.kind = "catalog" Тогда
		Результат.Вставить("code", НомерСтрокой(Код));
		Результат.Вставить("isFolder", Группа);
	Иначе
		Результат.Вставить("number", НомерСтрокой(Номер));
		Результат.Вставить("date", ?(ЗначениеЗаполнено(ДатаОбъекта), Формат(ДатаОбъекта, "ДФ=yyyy-MM-ddTHH:mm:ss"), Неопределено));
		Результат.Вставить("posted", Проведен);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция НомерСтрокой(Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0; ЧДЦ=0; ЧН=0");
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция Подготовить(Данные, ТипОбъекта, Схема, Ошибки) Экспорт
	Контекст = ?(ТипОбъекта.kind = "document", "document", "item");
	Шапка = ПодготовитьПоля(Данные.Получить("header"), Схема.fields, ТипОбъекта.metadata,
		Контекст, "header.", Истина, Ошибки);
	Таблицы = Новый Соответствие;
	Для Каждого Пара Из Данные.Получить("tables") Цикл
		Путь = "tables." + Пара.Ключ;
		Таблица = СчетаМагазинаМетаданные.НайтиОписание(Схема.tables, Пара.Ключ);
		Если Таблица = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестная табличная часть");
			Продолжить;
		КонецЕсли;
		Если Не Таблица.writable Или Таблица.appliesTo.Найти(Контекст) = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Табличная часть закрыта для записи");
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Пара.Значение) <> Тип("Массив") Тогда
			Ошибка(Ошибки, Путь, "Табличная часть должна быть массивом строк");
			Продолжить;
		КонецЕсли;
		Строки = Новый Массив;
		Для Каждого СтрокаJSON Из Пара.Значение Цикл
			ПутьСтроки = Путь + "[" + Формат(Строки.Количество(), "ЧГ=0; ЧН=0") + "]";
			Если ТипЗнч(СтрокаJSON) <> Тип("Соответствие") Тогда
				Ошибка(Ошибки, ПутьСтроки, "Строка таблицы должна быть объектом JSON");
				Строки.Добавить(Неопределено);
				Продолжить;
			КонецЕсли;
			Строки.Добавить(ПодготовитьПоля(СтрокаJSON, Таблица.fields, ТипОбъекта.metadata.ТабличныеЧасти[Таблица.name],
				Контекст, ПутьСтроки + ".", Ложь, Ошибки));
		КонецЦикла;
		Таблицы.Вставить(Таблица.name, Строки);
	КонецЦикла;
	Возврат Новый Структура("header,tables", Шапка, Таблицы);
КонецФункции

Функция ПодготовитьПоля(Вход, Поля, Мета, Контекст, ПрефиксПути, Шапка, Ошибки)
	Результат = Новый Соответствие;
	Для Каждого Пара Из Вход Цикл
		Путь = ПрефиксПути + Пара.Ключ;
		Поле = СчетаМагазинаМетаданные.НайтиОписание(Поля, Пара.Ключ);
		Если Поле = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестное поле");
			Продолжить;
		КонецЕсли;
		Если Не Поле.writable Или Поле.appliesTo.Найти(Контекст) = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Поле закрыто для записи");
			Продолжить;
		КонецЕсли;
		Роль = ?(Шапка И Поле.standard И Поле.name = "Родитель", "parent", "ordinary");
		МетаПоля = СчетаМагазинаМетаданные.Реквизит(Мета, Поле.name);
		Результат.Вставить(Поле.name, СчетаМагазинаЗначения.ИзJSON(Пара.Значение, Поле, МетаПоля.Тип, Роль, Путь, Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция Создать(ТипОбъекта) Экспорт
	Если ТипОбъекта.kind = "catalog" Тогда
		Возврат Справочники[ТипОбъекта.metadata.Имя].СоздатьЭлемент();
	КонецЕсли;
	Возврат Документы[ТипОбъекта.metadata.Имя].СоздатьДокумент();
КонецФункции

Процедура Заполнить(Объект, Данные) Экспорт
	Для Каждого Пара Из Данные.header Цикл
		Объект[Пара.Ключ] = Пара.Значение;
	КонецЦикла;
	Для Каждого Пара Из Данные.tables Цикл
		Таблица = Объект[Пара.Ключ];
		Таблица.Очистить();
		Для Каждого СтрокаДанных Из Пара.Значение Цикл
			СтрокаОбъекта = Таблица.Добавить();
			Для Каждого Поле Из СтрокаДанных Цикл
				СтрокаОбъекта[Поле.Ключ] = Поле.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ЗаписиРегистра(Регистр, Описание, Момент, Отбор, ЭтоСрез, Ошибки) Экспорт
	Мета = Регистр.metadata;
	ИменаИзмерений = ИменаПолей(Мета.Измерения);
	ИменаРесурсов = ИменаПолей(Мета.Ресурсы);
	ИменаРеквизитов = ИменаПолей(Мета.Реквизиты);
	// В текст запроса входят только имена метаданных; значения отбора — параметры.
	Запрос = Новый Запрос;
	Условие = УсловиеОтбора(ИменаИзмерений, Отбор, ?(ЭтоСрез, "", "Записи."), Запрос);
	Если ЭтоСрез Тогда
		Источник = Мета.ПолноеИмя() + ".СрезПоследних(&Дата" + ?(ПустаяСтрока(Условие), "", ", " + Условие) + ")";
		Запрос.УстановитьПараметр("Дата", Момент);
	Иначе
		Источник = Мета.ПолноеИмя();
	КонецЕсли;
	Поля = Новый Массив;
	Поля.Добавить("Записи.Период КАК Период");
	ДобавитьПоляЗапроса(Поля, ИменаИзмерений);
	ДобавитьПоляЗапроса(Поля, ИменаРесурсов);
	ДобавитьПоляЗапроса(Поля, ИменаРеквизитов);
	Порядок = Новый Массив;
	Если Не ЭтоСрез Тогда
		Порядок.Добавить("Период УБЫВ");
	КонецЕсли;
	Для Каждого Имя Из ИменаИзмерений Цикл
		Порядок.Добавить(Имя);
	КонецЦикла;
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 101" + Символы.ПС
		+ Символы.Таб + СтрСоединить(Поля, "," + Символы.ПС + Символы.Таб) + Символы.ПС
		+ "ИЗ" + Символы.ПС + Символы.Таб + Источник + " КАК Записи";
	Если Не ЭтоСрез И Не ПустаяСтрока(Условие) Тогда
		Текст = Текст + Символы.ПС + "ГДЕ" + Символы.ПС + Символы.Таб + Условие;
	КонецЕсли;
	Если Порядок.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "УПОРЯДОЧИТЬ ПО" + Символы.ПС + Символы.Таб + СтрСоединить(Порядок, "," + Символы.ПС + Символы.Таб);
	КонецЕсли;
	Запрос.Текст = Текст;
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Элементы.Количество() = 100 Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Индекс = Элементы.Количество();
		Элементы.Добавить(Новый Структура("period,dimensions,resources,attributes",
			Формат(Выборка.Период, "ДФ=yyyy-MM-ddTHH:mm:ss"),
			РазделЗаписи(Выборка, ИменаИзмерений, Описание.dimensions, Мета.Измерения, Индекс, "dimensions", Ошибки),
			РазделЗаписи(Выборка, ИменаРесурсов, Описание.resources, Мета.Ресурсы, Индекс, "resources", Ошибки),
			РазделЗаписи(Выборка, ИменаРеквизитов, Описание.attributes, Мета.Реквизиты, Индекс, "attributes", Ошибки)));
	КонецЦикла;
	Возврат Новый Структура("items,hasMore", Элементы, ЕстьЕще);
КонецФункции

Функция ИменаПолей(Коллекция)
	Имена = Новый Массив;
	Для Каждого Поле Из Коллекция Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	Возврат Имена;
КонецФункции

Функция УсловиеОтбора(Имена, Отбор, Префикс, Запрос)
	Части = Новый Массив;
	Номер = 0;
	Для Каждого Имя Из Имена Цикл
		Если Не СчетаМагазинаЗначения.ЕстьКлюч(Отбор, Имя) Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Параметр = "Отбор" + Формат(Номер, "ЧГ=0");
		Части.Добавить(Префикс + Имя + " = &" + Параметр);
		Запрос.УстановитьПараметр(Параметр, Отбор.Получить(Имя));
	КонецЦикла;
	Возврат СтрСоединить(Части, " И ");
КонецФункции

Процедура ДобавитьПоляЗапроса(Поля, Имена)
	Для Каждого Имя Из Имена Цикл
		Поля.Добавить("Записи." + Имя + " КАК " + Имя);
	КонецЦикла;
КонецПроцедуры

Функция РазделЗаписи(Выборка, Имена, Описания, МетаКоллекция, Индекс, ИмяРаздела, Ошибки)
	Результат = Новый Структура;
	Для Каждого Имя Из Имена Цикл
		Поле = СчетаМагазинаМетаданные.НайтиОписание(Описания, Имя);
		МетаПоля = МетаКоллекция.Найти(Имя);
		Путь = "items[" + Формат(Индекс, "ЧГ=0") + "]." + ИмяРаздела + "." + Имя;
		Результат.Вставить(Имя, СчетаМагазинаЗначения.ВJSON(Выборка[Имя], Поле, МетаПоля.Тип, Путь, Ошибки));
	КонецЦикла;
	Возврат Результат;
КонецФункции
