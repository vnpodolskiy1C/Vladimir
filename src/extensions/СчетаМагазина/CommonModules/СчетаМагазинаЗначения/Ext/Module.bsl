Функция ВJSON(Значение, Поле, ТипыПоля, Путь, Ошибки) Экспорт
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Null") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ФактическийТип = ТипЗнч(Значение);
	Вариант = СчетаМагазинаМетаданные.ОписаниеТипа(ФактическийТип, ТипыПоля);
	Если Не Вариант.readable Тогда
		Ошибка(Ошибки, Путь, "Фактическое значение не поддерживается для полного чтения", Вариант.name);
		Возврат Неопределено;
	КонецЕсли;
	Если Вариант.kind = "string" Или Вариант.kind = "number" Или Вариант.kind = "boolean" Тогда
		Результат = Значение;
	ИначеЕсли Вариант.kind = "date" Тогда
		Если Вариант.parts = "time" Тогда
			Результат = Формат(Значение, "ДФ=HH:mm:ss; ДП=00:00:00");
		ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
			Результат = Неопределено;
		ИначеЕсли Вариант.parts = "date" Тогда
			Результат = Формат(Значение, "ДФ=yyyy-MM-dd");
		Иначе
			Результат = Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
		КонецЕсли;
	ИначеЕсли Вариант.kind = "uuid" Тогда
		Результат = НРег(Строка(Значение));
	ИначеЕсли Не ЗначениеЗаполнено(Значение) Тогда
		Результат = Неопределено;
	ИначеЕсли Вариант.kind = "enum" Тогда
		Мета = Метаданные.НайтиПоТипу(ФактическийТип);
		Результат = Мета.ЗначенияПеречисления[Перечисления[Мета.Имя].Индекс(Значение)].Имя;
	Иначе
		Результат = НРег(Строка(Значение.УникальныйИдентификатор()));
	КонецЕсли;
	Если Поле.types.Количество() > 1 Тогда
		Возврат Новый Структура("type,value", Вариант.name, Результат);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция УникальныйИдентификаторИзСтроки(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) <> 36 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Индекс = 1 По 36 Цикл
		Символ = НРег(Сред(Значение, Индекс, 1));
		Если Индекс = 9 Или Индекс = 14 Или Индекс = 19 Или Индекс = 24 Тогда
			Если Символ <> "-" Тогда
				Возврат Неопределено;
			КонецЕсли;
		ИначеЕсли СтрНайти("0123456789abcdef", Символ) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый УникальныйИдентификатор(Значение);
КонецФункции

Процедура Ошибка(Ошибки, Путь, Текст, Тип = Неопределено) Экспорт
	Деталь = Новый Структура("path,message", Путь, Текст);
	Если Тип <> Неопределено Тогда
		Деталь.Вставить("type", Тип);
	КонецЕсли;
	Ошибки.Добавить(Деталь);
КонецПроцедуры

Функция ИзJSON(Знач Вход, Поле, ТипыПоля, РольСсылки, Путь, Ошибки) Экспорт
	ВыбранныеТипы = ТипыПоля;
	Вариант = Неопределено;
	Если Поле.types.Количество() > 1 И Вход <> Неопределено Тогда
		Если ТипЗнч(Вход) <> Тип("Соответствие") Тогда
			Ошибка(Ошибки, Путь, "Требуется объект type,value для составного поля");
			Возврат Неопределено;
		КонецЕсли;
		Если Вход.Количество() <> 2 Или Не ЕстьКлюч(Вход, "type") Или Не ЕстьКлюч(Вход, "value") Тогда
			Ошибка(Ошибки, Путь, "Составное поле должно содержать только type,value");
			Возврат Неопределено;
		КонецЕсли;
		Вариант = СчетаМагазинаМетаданные.НайтиОписание(Поле.types, Вход.Получить("type"));
		Если Вариант = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Неизвестный вариант составного поля");
			Возврат Неопределено;
		КонецЕсли;
		ТипыВарианта = Новый Массив;
		Для Каждого ТипПоля Из ТипыПоля.Типы() Цикл
			Если СчетаМагазинаМетаданные.ОписаниеТипа(ТипПоля, ТипыПоля).name = Вариант.name Тогда
				ТипыВарианта.Добавить(ТипПоля);
			КонецЕсли;
		КонецЦикла;
		ВыбранныеТипы = Новый ОписаниеТипов(ТипыВарианта, ТипыПоля.КвалификаторыЧисла,
			ТипыПоля.КвалификаторыСтроки, ТипыПоля.КвалификаторыДаты);
		Вход = Вход.Получить("value");
	ИначеЕсли Поле.types.Количество() = 1 Тогда
		Вариант = Поле.types[0];
	КонецЕсли;
	// Проверка выбранного варианта предшествует обработке null.
	Если Вариант <> Неопределено И Не Вариант.writable Тогда
		Ошибка(Ошибки, Путь, "Выбранный вариант закрыт для записи", Вариант.name);
		Возврат Неопределено;
	КонецЕсли;
	Если Вход = Неопределено Тогда
		Пустое = ВыбранныеТипы.ПривестиЗначение(Неопределено);
		Фактический = СчетаМагазинаМетаданные.ОписаниеТипа(ТипЗнч(Пустое), ВыбранныеТипы);
		Если Не Фактический.writable Тогда
			Ошибка(Ошибки, Путь, "Платформенный пустой вариант закрыт для записи", Фактический.name);
		КонецЕсли;
		Возврат Пустое;
	КонецЕсли;
	Вид = Вариант.kind;
	Если Вид = "string" Тогда
		Если ТипЗнч(Вход) <> Тип("Строка") Тогда
			Ошибка(Ошибки, Путь, "Требуется строка JSON");
		ИначеЕсли Вариант.length > 0 И (СтрДлина(Вход) > Вариант.length
			Или Вариант.fixedLength И СтрДлина(Вход) <> Вариант.length) Тогда
			Ошибка(Ошибки, Путь, "Длина строки не соответствует квалификаторам");
		КонецЕсли;
		Возврат Вход;
	ИначеЕсли Вид = "number" Тогда
		Если ТипЗнч(Вход) <> Тип("Число") Тогда
			Ошибка(Ошибки, Путь, "Требуется число JSON");
		ИначеЕсли Вариант.nonnegative И Вход < 0 Или Окр(Вход, Вариант.fractionDigits) <> Вход
			Или ?(Вход < 0, -Вход, Вход) >= Pow(10, Вариант.digits - Вариант.fractionDigits) Тогда
			Ошибка(Ошибки, Путь, "Число не соответствует разрядности, дробной части или знаку");
		КонецЕсли;
		Возврат Вход;
	ИначеЕсли Вид = "boolean" Тогда
		Если ТипЗнч(Вход) <> Тип("Булево") Тогда
			Ошибка(Ошибки, Путь, "Требуется булево значение JSON");
		КонецЕсли;
		Возврат Вход;
	ИначеЕсли Вид = "date" Тогда
		Возврат ДатаИзJSON(Вход, Вариант, Путь, Ошибки);
	ИначеЕсли Вид = "uuid" Тогда
		Результат = УникальныйИдентификаторИзСтроки(Вход);
		Если Результат = Неопределено Тогда
			Ошибка(Ошибки, Путь, "Требуется UUID в канонической форме с дефисами");
		КонецЕсли;
		Возврат Результат;
	ИначеЕсли Вид = "enum" Тогда
		Мета = Метаданные.НайтиПоТипу(ВыбранныеТипы.Типы()[0]);
		Для Каждого ЗначениеМета Из Мета.ЗначенияПеречисления Цикл
			Если ЗначениеМета.Имя = Вход Тогда
				Возврат Перечисления[Мета.Имя][ЗначениеМета.Имя];
			КонецЕсли;
		КонецЦикла;
		Ошибка(Ошибки, Путь, "Неизвестное техническое имя значения перечисления");
	ИначеЕсли Вид = "catalog" Или Вид = "document" Тогда
		Возврат СсылкаИзJSON(Вход, ВыбранныеТипы, Вид, РольСсылки, Путь, Ошибки);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЕстьКлюч(Словарь, Ключ) Экспорт
	Для Каждого Пара Из Словарь Цикл
		Если Пара.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДатаИзJSON(Вход, Вариант, Путь, Ошибки)
	Маска = ?(Вариант.parts = "time", "00:00:00", ?(Вариант.parts = "date", "0000-00-00", "0000-00-00T00:00:00"));
	Корректно = ТипЗнч(Вход) = Тип("Строка");
	Если Корректно Тогда
		Корректно = СтрДлина(Вход) = СтрДлина(Маска);
	КонецЕсли;
	Если Корректно Тогда
		Для Индекс = 1 По СтрДлина(Маска) Цикл
			Знак = Сред(Вход, Индекс, 1);
			Эталон = Сред(Маска, Индекс, 1);
			Если Эталон = "0" И СтрНайти("0123456789", Знак) = 0 Или Эталон <> "0" И Знак <> Эталон Тогда
				Корректно = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Корректно Тогда
		Попытка
			СтрокаДаты = ?(Вариант.parts = "time", "0001-01-01T" + Вход, ?(Вариант.parts = "date", Вход + "T00:00:00", Вход));
			Результат = ПрочитатьДатуJSON(СтрокаДаты, ФорматДатыJSON.ISO);
			ФорматДаты = ?(Вариант.parts = "time", "ДФ=HH:mm:ss; ДП=00:00:00", ?(Вариант.parts = "date", "ДФ=yyyy-MM-dd", "ДФ=yyyy-MM-ddTHH:mm:ss"));
			Если Формат(Результат, ФорматДаты) = Вход Тогда
				Возврат Результат;
			КонецЕсли;
		Исключение
			// Ошибка разбора входного значения не является сбоем записи.
		КонецПопытки;
	КонецЕсли;
	Ошибка(Ошибки, Путь, "Неверная дата или время: требуется " + Маска + " без часового пояса");
	Возврат Неопределено;
КонецФункции

Функция СсылкаИзJSON(Вход, ТипыПоля, Вид, РольСсылки, Путь, Ошибки)
	Идентификатор = УникальныйИдентификаторИзСтроки(Вход);
	Если Идентификатор <> Неопределено Тогда
		Мета = Метаданные.НайтиПоТипу(ТипыПоля.Типы()[0]);
		Если ПравоДоступа("Чтение", Мета) Тогда
			Попытка
				Менеджер = ?(Вид = "catalog", Справочники[Мета.Имя], Документы[Мета.Имя]);
				Ссылка = Менеджер.ПолучитьСсылку(Идентификатор);
				ТипЦели = Новый Структура("kind,metadata", Вид, Мета);
				Группы = СчетаМагазинаМетаданные.ЕстьГруппы(ТипЦели);
				Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ Ссылка ИЗ " + Мета.ПолноеИмя()
					+ " ГДЕ Ссылка = &Ссылка И НЕ ПометкаУдаления"
					+ ?(Группы И РольСсылки <> "parent", " И НЕ ЭтоГруппа", ""));
				Запрос.УстановитьПараметр("Ссылка", Ссылка);
				Если Не Запрос.Выполнить().Пустой() Тогда
					Возврат Ссылка;
				КонецЕсли;
			Исключение
				Информация = ИнформацияОбОшибке();
				Если Не Информация.ЯвляетсяОшибкойКатегории(КатегорияОшибки.НарушениеПравДоступа, Ложь) Тогда
					ВызватьИсключение;
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	Ошибка(Ошибки, Путь, "Ссылка некорректна, отсутствует, недоступна, помечена на удаление или является группой вне поля родителя");
	Возврат Неопределено;
КонецФункции
