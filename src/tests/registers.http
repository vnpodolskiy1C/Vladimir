# Регистры сведений в сервисе объектов: по запросу на каждый маршрут.
# Адрес, авторизация и идентификаторы демо-данных — в .env рядом (образец — .env.example).
# Даты среза считает REST Client: сейчас и месяц назад.
# POST записывает значение в базу: повтор на тот же период и ключ заменяет прежнее.

### Поиск регистра по слову
# @name registerTypes
GET {{$dotenv OBJECT_SERVICE_URL}}/types?q=цен&limit=100
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Описание: РегистрСведений._ДемоЦеныНоменклатуры
# @name pricesSchema
GET {{$dotenv OBJECT_SERVICE_URL}}/register?name=РегистрСведений._ДемоЦеныНоменклатуры
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Описание: РегистрСведений.КурсыВалют
# @name ratesSchema
GET {{$dotenv OBJECT_SERVICE_URL}}/register?name=РегистрСведений.КурсыВалют
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Описание: РегистрСведений._ДемоРаботникиОрганизаций
# @name workersSchema
GET {{$dotenv OBJECT_SERVICE_URL}}/register?name=РегистрСведений._ДемоРаботникиОрганизаций
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Срез: цена товара сейчас
# @name priceNow
GET {{$dotenv OBJECT_SERVICE_URL}}/register/slice?name=РегистрСведений._ДемоЦеныНоменклатуры&date={{$datetime "YYYY-MM-DDTHH:mm:ss"}}&Номенклатура={{$dotenv REGISTER_PRODUCT}}
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Срез: цена товара месяц назад
# @name priceMonthAgo
GET {{$dotenv OBJECT_SERVICE_URL}}/register/slice?name=РегистрСведений._ДемоЦеныНоменклатуры&date={{$datetime "YYYY-MM-DDTHH:mm:ss" -1 M}}&Номенклатура={{$dotenv REGISTER_PRODUCT}}
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Срез: курс валюты на сегодня
# @name rateToday
GET {{$dotenv OBJECT_SERVICE_URL}}/register/slice?name=РегистрСведений.КурсыВалют&date={{$datetime "YYYY-MM-DD"}}&Валюта={{$dotenv REGISTER_CURRENCY}}
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Срез: где числится работник
# @name workerNow
GET {{$dotenv OBJECT_SERVICE_URL}}/register/slice?name=РегистрСведений._ДемоРаботникиОрганизаций&date={{$datetime "YYYY-MM-DD"}}&Организация={{$dotenv REGISTER_ORGANIZATION}}&ФизическоеЛицо={{$dotenv REGISTER_PERSON}}
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### История: все цены товара
# @name priceHistory
GET {{$dotenv OBJECT_SERVICE_URL}}/register/history?name=РегистрСведений._ДемоЦеныНоменклатуры&Номенклатура={{$dotenv REGISTER_PRODUCT}}
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}

### Запись: новая цена товара с сегодняшнего дня
# @name priceRecord
POST {{$dotenv OBJECT_SERVICE_URL}}/register/record
Authorization: {{$dotenv OBJECT_SERVICE_AUTH}}
Content-Type: application/json; charset=utf-8

{
  "name": "РегистрСведений._ДемоЦеныНоменклатуры",
  "period": "{{$datetime "YYYY-MM-DD"}}T00:00:00",
  "dimensions": { "Номенклатура": "{{$dotenv REGISTER_PRODUCT}}" },
  "resources": { "Цена": 1500 }
}
