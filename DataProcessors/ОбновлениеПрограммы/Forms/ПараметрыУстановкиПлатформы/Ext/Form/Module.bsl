#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимУстановкиПлатформы                 = Параметры.РежимУстановкиПлатформы;
	СохранятьДистрибутивыПлатформыВКаталог  = Параметры.СохранятьДистрибутивыПлатформыВКаталог;
	КаталогСохраненияПлатформы              = Параметры.КаталогСохраненияПлатформы;
	ДоступноСохранениеДистрибутиваПлатформы = Параметры.ДоступноСохранениеДистрибутиваПлатформы;
	
	Элементы.ГруппаКаталогСохраненияКомпонентаПлатформы.Видимость         = ДоступноСохранениеДистрибутиваПлатформы;
	Элементы.КаталогСохраненияДистрибутиваКомпонентаПлатформы.Доступность = СохранятьДистрибутивыПлатформыВКаталог;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СохранятьДистрибутивыКомпонентаПлатформыВКаталогПриИзменении(Элемент)
	
	Элементы.КаталогСохраненияДистрибутиваКомпонентаПлатформы.Доступность = СохранятьДистрибутивыПлатформыВКаталог;
	Если СохранятьДистрибутивыПлатформыВКаталог Тогда
		//@skip-check bsl-legacy-check-dynamic-feature-access
		КаталогСохраненияПлатформы = ПолучениеОбновленийПрограммыКлиентСервер.КаталогДляРаботыСОбновлениямиПлатформы();
	Иначе
		КаталогСохраненияПлатформы = КаталогДистрибутиваПлатформыПоУмолчанию();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура КаталогСохраненияДистрибутиваКомпонентаПлатформыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбора.Заголовок = НСтр("ru = 'Каталог хранения дистрибутивов платформы 1С:Предприятие'");
	ДиалогВыбора.Каталог   = Элемент.ТекстРедактирования;
	
	РезультатВыбора = Ждать ДиалогВыбора.ВыбратьАсинх();
	Если РезультатВыбора <> Неопределено Тогда
		КаталогСохраненияПлатформы = РезультатВыбора[0];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	// Проверка заполнения
	Если ДоступноСохранениеДистрибутиваПлатформы
		И СохранятьДистрибутивыПлатформыВКаталог
		И ПустаяСтрока(КаталогСохраненияПлатформы) Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не выбран каталог хранения дистрибутивов платформы.'"),
			,
			"КаталогСохраненияДистрибутиваКомпонентаПлатформы");
		Возврат;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("РежимУстановкиПлатформы"                , РежимУстановкиПлатформы);
	Результат.Вставить("СохранятьДистрибутивыПлатформыВКаталог" , СохранятьДистрибутивыПлатформыВКаталог);
	Результат.Вставить("КаталогСохраненияПлатформы"             , КаталогСохраненияПлатформы);
	
	Закрыть(Результат);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция КаталогДистрибутиваПлатформыПоУмолчанию()
	
	//@skip-check bsl-legacy-check-dynamic-feature-access
	Возврат ПолучениеОбновленийПрограммыКлиентСервер.КаталогДляРаботыСОбновлениямиПлатформы()
		+ ?(ПолучениеОбновленийПрограммыКлиентСервер.Это64РазрядноеПриложение(), "setup_64\", "setup\");
	
КонецФункции

#КонецОбласти